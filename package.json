{
  "name": "bizentra",
  "version": "0.1.0",
  "private": true,
  "description": "Bizentra multi-business POS SaaS monorepo",
  "packageManager": "pnpm@10.28.1",
  "engines": {
    "node": ">=24.0.0 <25",
    "pnpm": ">=10.0.0 <11"
  },
  "scripts": {
    "build": "turbo run build",
    "clean": "turbo run clean && rimraf node_modules .turbo",
    "dev": "dotenv -e .env -- turbo run dev --parallel",
    "dev:api": "dotenv -e .env -- pnpm --filter @bizentra/api dev",
    "dev:backoffice": "dotenv -e .env -- pnpm --filter @bizentra/backoffice dev",
    "dev:pos": "dotenv -e .env -- pnpm --filter @bizentra/pos dev",
    "dev:worker": "dotenv -e .env -- pnpm --filter @bizentra/worker dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "test:coverage": "turbo run test:coverage",
    "typecheck": "turbo run typecheck",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "db:generate": "pnpm --filter @bizentra/database db:generate",
    "db:migrate": "pnpm --filter @bizentra/database db:migrate",
    "db:migrate:deploy": "pnpm --filter @bizentra/database db:migrate:deploy",
    "db:studio": "pnpm --filter @bizentra/database db:studio",
    "infra:up": "docker compose --env-file .env -f infrastructure/local/compose.yaml up -d --wait",
    "infra:down": "docker compose --env-file .env -f infrastructure/local/compose.yaml down",
    "infra:logs": "docker compose --env-file .env -f infrastructure/local/compose.yaml logs -f",
    "infra:status": "docker compose --env-file .env -f infrastructure/local/compose.yaml ps"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/node": "^24.0.0",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9.0.0",
    "prettier": "^3.9.6",
    "rimraf": "^6.1.2",
    "tsup": "^8.5.1",
    "turbo": "^2.10.11",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.0.0",
    "vitest": "^4.1.11"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/engines",
      "esbuild",
      "msgpackr-extract",
      "prisma",
      "unrs-resolver"
    ]
  }
}
