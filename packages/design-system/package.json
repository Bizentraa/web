{
  "name": "@bizentra/design-system",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./theme": {
      "types": "./dist/theme.d.ts",
      "import": "./dist/theme.js",
      "default": "./dist/theme.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js",
      "default": "./dist/client.js"
    },
    "./styles.css": "./styles.css"
  },
  "scripts": {
    "build": "tsup src/index.tsx src/theme.tsx src/client.tsx --format esm --dts --clean --external react",
    "clean": "rimraf dist",
    "lint": "eslint src --max-warnings=0",
    "test": "vitest run --passWithNoTests",
    "test:coverage": "vitest run --coverage --passWithNoTests",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": "^19.2.8"
  },
  "dependencies": {
    "@bizentra/themes": "workspace:*",
    "lucide-react": "^1.34.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "react": "^19.2.8"
  },
  "files": [
    "dist",
    "styles.css"
  ]
}
