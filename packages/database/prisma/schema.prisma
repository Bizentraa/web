  CARD
  TRANSFER
  QR_WALLET
  STORE_CREDIT
  OTHER
}

enum PaymentDirection {
  IN
  OUT
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  UNKNOWN
  VOIDED
}

enum ReturnStatus {
  DRAFT
  ACCEPTED
  CANCELLED
}

enum RefundMethod {
  ORIGINAL_METHOD
  CASH
  STORE_CREDIT
}

enum StockDisposition {
  RESELLABLE
  DAMAGED
  QUARANTINE
}

enum StoreCreditEntryKind {
  ISSUE
  REDEEM
  ADJUST
}

enum StockMovementKind {
  OPENING
  ADJUSTMENT
  TRANSFER_OUT
  TRANSFER_IN
  RECEIPT
  PICK
  PACK
  DISPATCH
  RETURN
}

enum StockMovementStatus {
