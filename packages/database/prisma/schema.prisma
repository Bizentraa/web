  ACTIVE
  DISABLED
  LOST
}

enum OfflineQueueStatus {
  QUEUED
  SYNCED
  CONFLICT
  FAILED
  CANCELLED
}

enum SyncConflictStatus {
  OPEN
  RESOLVED
  IGNORED
}

enum DataExportStatus {
