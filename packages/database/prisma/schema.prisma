/// CC-P0-007: an approval request is the auditable lifecycle record for one sensitive action.
model ApprovalRequest {
  id                      String                @id @default(uuid()) @db.Uuid
  businessId              String                @db.Uuid
  branchId                String?               @db.Uuid
  policyId                String?               @db.Uuid
  actionCode              String                @db.VarChar(80)
  entityType              String                @db.VarChar(80)
  entityId                String?               @db.VarChar(80)
  status                  ApprovalRequestStatus @default(PENDING)
  amount                  Decimal?              @db.Decimal(19, 4)
  currencyCode            String?               @db.Char(3)
  reason                  String                @db.VarChar(500)
  context                 Json?
  requestedByMembershipId String                @db.Uuid
  decidedByMembershipId   String?               @db.Uuid
  decisionNote            String?               @db.VarChar(500)
  requestedAt             DateTime              @default(now()) @db.Timestamptz(3)
  decidedAt               DateTime?             @db.Timestamptz(3)
  createdAt               DateTime              @default(now()) @db.Timestamptz(3)
  updatedAt               DateTime              @updatedAt @db.Timestamptz(3)

  business    Business            @relation(fields: [businessId], references: [id], onDelete: Restrict)
  branch      Branch?             @relation(fields: [branchId, businessId], references: [id, businessId], onDelete: Restrict)
  policy      ApprovalPolicy?     @relation(fields: [policyId, businessId], references: [id, businessId], onDelete: Restrict)
  requestedBy BusinessMembership  @relation("ApprovalRequestedBy", fields: [requestedByMembershipId, businessId], references: [id, businessId], onDelete: Restrict)
  decidedBy   BusinessMembership? @relation("ApprovalDecidedBy", fields: [decidedByMembershipId, businessId], references: [id, businessId], onDelete: Restrict)
  returns     SaleReturn[]
  decisions   ApprovalDecision[]

  @@unique([id, businessId])
  @@index([businessId, status, requestedAt])
  @@index([businessId, actionCode, status])
  @@map("approval_requests")
}

/// CC-P0-007: each approval decision is retained so multi-approver strategies are auditable.
model ApprovalDecision {
  id                    String                @id @default(uuid()) @db.Uuid
  businessId            String                @db.Uuid
  approvalRequestId     String                @db.Uuid
  decidedByMembershipId String                @db.Uuid
  decision              ApprovalRequestStatus
  note                  String?               @db.VarChar(500)
  decidedAt             DateTime              @default(now()) @db.Timestamptz(3)

  business        Business           @relation(fields: [businessId], references: [id], onDelete: Restrict)
  approvalRequest ApprovalRequest    @relation(fields: [approvalRequestId, businessId], references: [id, businessId], onDelete: Cascade)
  decidedBy       BusinessMembership @relation("ApprovalDecisionActor", fields: [decidedByMembershipId, businessId], references: [id, businessId], onDelete: Restrict)

  @@unique([businessId, approvalRequestId, decidedByMembershipId])
  @@index([businessId, approvalRequestId, decision])
  @@map("approval_decisions")
}

/// CC-P2-001: a POS shift owns opening cash, cash movements and closing reconciliation.
model PosShift {
  id                   String      @id @default(uuid()) @db.Uuid
  businessId           String      @db.Uuid
  branchId             String      @db.Uuid
  registerCode         String      @db.VarChar(40)
  number               String      @db.VarChar(60)
  status               ShiftStatus @default(OPEN)
  openingFloat         Decimal     @db.Decimal(19, 4)
  expectedCash         Decimal?    @db.Decimal(19, 4)
  countedCash          Decimal?    @db.Decimal(19, 4)
  cashVariance         Decimal?    @db.Decimal(19, 4)
  varianceReason       String?     @db.VarChar(500)
  openedByMembershipId String      @db.Uuid
  closedByMembershipId String?     @db.Uuid
  openedAt             DateTime    @default(now()) @db.Timestamptz(3)
  closedAt             DateTime?   @db.Timestamptz(3)
  createdAt            DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime    @updatedAt @db.Timestamptz(3)

  business      Business            @relation(fields: [businessId], references: [id], onDelete: Restrict)
  branch        Branch              @relation(fields: [branchId, businessId], references: [id, businessId], onDelete: Restrict)
  openedBy      BusinessMembership  @relation("ShiftOpenedBy", fields: [openedByMembershipId, businessId], references: [id, businessId], onDelete: Restrict)
  closedBy      BusinessMembership? @relation("ShiftClosedBy", fields: [closedByMembershipId, businessId], references: [id, businessId], onDelete: Restrict)
  cashMovements CashMovement[]
  sales         Sale[]
  returns       SaleReturn[]

  @@unique([businessId, number])
  @@unique([id, businessId])
  @@index([businessId, branchId, status])
  @@map("pos_shifts")
}

/// CC-P2-001: every cash change inside a shift stays visible for reconciliation.
model CashMovement {
  id                    String           @id @default(uuid()) @db.Uuid
  businessId            String           @db.Uuid
  shiftId               String           @db.Uuid
  kind                  CashMovementKind
  amount                Decimal          @db.Decimal(19, 4)
  reason                String           @db.VarChar(240)
  createdByMembershipId String           @db.Uuid
  createdAt             DateTime         @default(now()) @db.Timestamptz(3)

  shift     PosShift           @relation(fields: [shiftId, businessId], references: [id, businessId], onDelete: Cascade)
  createdBy BusinessMembership @relation("CashMovementCreatedBy", fields: [createdByMembershipId, businessId], references: [id, businessId], onDelete: Restrict)

  @@index([businessId, shiftId])
  @@map("cash_movements")
}

/// CC-P2-002: one confirmed sale record shared by POS and Back Office.
model Sale {
  id                    String      @id @default(uuid()) @db.Uuid
  businessId            String      @db.Uuid
  branchId              String      @db.Uuid
  shiftId               String?     @db.Uuid
  number                String      @db.VarChar(60)
  receiptNumber         String?     @db.VarChar(60)
  status                SaleStatus  @default(DRAFT)
  channel               SaleChannel @default(POS)
  customerId            String?     @db.Uuid
  currencyCode          String      @db.Char(3)
  subtotal              Decimal     @default(0) @db.Decimal(19, 4)
  discountTotal         Decimal     @default(0) @db.Decimal(19, 4)
  taxTotal              Decimal     @default(0) @db.Decimal(19, 4)
  total                 Decimal     @default(0) @db.Decimal(19, 4)
  paidTotal             Decimal     @default(0) @db.Decimal(19, 4)
  changeTotal           Decimal     @default(0) @db.Decimal(19, 4)
  dueTotal              Decimal     @default(0) @db.Decimal(19, 4)
  refundedTotal         Decimal     @default(0) @db.Decimal(19, 4)
  idempotencyKey        String      @db.VarChar(80)
  offlineRef            String?     @db.VarChar(80)
  holdName              String?     @db.VarChar(120)
  note                  String?     @db.VarChar(500)
  voidReason            String?     @db.VarChar(500)
  createdByMembershipId String      @db.Uuid
  confirmedAt           DateTime?   @db.Timestamptz(3)
  voidedAt              DateTime?   @db.Timestamptz(3)
  createdAt             DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime    @updatedAt @db.Timestamptz(3)

  business  Business           @relation(fields: [businessId], references: [id], onDelete: Restrict)
  branch    Branch             @relation(fields: [branchId, businessId], references: [id, businessId], onDelete: Restrict)
  shift     PosShift?          @relation(fields: [shiftId, businessId], references: [id, businessId], onDelete: Restrict)
  customer  Customer?          @relation(fields: [customerId, businessId], references: [id, businessId], onDelete: Restrict)
  createdBy BusinessMembership @relation("SaleCreatedBy", fields: [createdByMembershipId, businessId], references: [id, businessId], onDelete: Restrict)
  lines     SaleLine[]
  payments  SalePayment[]
  returns   SaleReturn[]
  credits   StoreCreditEntry[]

  @@unique([businessId, number])
  @@unique([businessId, idempotencyKey])
  @@unique([id, businessId])
  @@index([businessId, branchId, status, createdAt])
  @@index([businessId, customerId])
  @@map("sales")
}

/// CC-P2-002: sale lines keep the resolved price, discount and tax used at sale time.
model SaleLine {
  id               String        @id @default(uuid()) @db.Uuid
  businessId       String        @db.Uuid
  saleId           String        @db.Uuid
  lineNo           Int
  itemId           String        @db.Uuid
  variantId        String?       @db.Uuid
  unitId           String        @db.Uuid
  description      String        @db.VarChar(240)
  quantity         Decimal       @db.Decimal(19, 4)
  unitPrice        Decimal       @db.Decimal(19, 4)
  discountKind     DiscountKind?
  discountValue    Decimal       @default(0) @db.Decimal(19, 4)
  discountAmount   Decimal       @default(0) @db.Decimal(19, 4)
  promotionId      String?       @db.Uuid
  taxRateId        String?       @db.Uuid
  taxRatePercent   Decimal       @default(0) @db.Decimal(9, 6)
  taxAmount        Decimal       @default(0) @db.Decimal(19, 4)
  lineSubtotal     Decimal       @default(0) @db.Decimal(19, 4)
  lineTotal        Decimal       @default(0) @db.Decimal(19, 4)
  costPrice        Decimal?      @db.Decimal(19, 4)
  stockTracked     Boolean       @default(false)
  returnedQuantity Decimal       @default(0) @db.Decimal(19, 4)
  createdAt        DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime      @updatedAt @db.Timestamptz(3)

  sale        Sale             @relation(fields: [saleId, businessId], references: [id, businessId], onDelete: Cascade)
  item        Item             @relation(fields: [itemId, businessId], references: [id, businessId], onDelete: Restrict)
  variant     ItemVariant?     @relation(fields: [variantId, businessId], references: [id, businessId], onDelete: Restrict)
  unit        Unit             @relation(fields: [unitId, businessId], references: [id, businessId], onDelete: Restrict)
  promotion   Promotion?       @relation(fields: [promotionId, businessId], references: [id, businessId], onDelete: Restrict)
  taxRate     TaxRate?         @relation(fields: [taxRateId, businessId], references: [id, businessId], onDelete: Restrict)
  returnLines SaleReturnLine[]

  @@unique([businessId, saleId, lineNo])
  @@unique([id, businessId])
  @@index([businessId, itemId])
  @@map("sale_lines")
}

/// CC-P2-005 and CC-P2-007: each tender attempt is idempotent and keeps its own state.
model SalePayment {
  id                    String            @id @default(uuid()) @db.Uuid
  businessId            String            @db.Uuid
  saleId                String            @db.Uuid
  returnId              String?           @db.Uuid
  method                PaymentMethodKind
  direction             PaymentDirection  @default(IN)
  status                PaymentStatus     @default(PENDING)
  amount                Decimal           @db.Decimal(19, 4)
  tenderedAmount        Decimal?          @db.Decimal(19, 4)
  changeAmount          Decimal           @default(0) @db.Decimal(19, 4)
  reference             String?           @db.VarChar(120)
  failureReason         String?           @db.VarChar(240)
  idempotencyKey        String            @db.VarChar(80)
  createdByMembershipId String            @db.Uuid
  capturedAt            DateTime?         @db.Timestamptz(3)
  createdAt             DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime          @updatedAt @db.Timestamptz(3)

  sale       Sale               @relation(fields: [saleId, businessId], references: [id, businessId], onDelete: Cascade)
  saleReturn SaleReturn?        @relation(fields: [returnId, businessId], references: [id, businessId], onDelete: Restrict)
  createdBy  BusinessMembership @relation("PaymentCreatedBy", fields: [createdByMembershipId, businessId], references: [id, businessId], onDelete: Restrict)

  @@unique([businessId, idempotencyKey])
  @@index([businessId, saleId, status])
  @@map("sale_payments")
}

/// CC-P2-009 to CC-P2-011: a return always references the original sale.
model SaleReturn {
  id                    String       @id @default(uuid()) @db.Uuid
  businessId            String       @db.Uuid
  branchId              String       @db.Uuid
  saleId                String       @db.Uuid
  shiftId               String?      @db.Uuid
  exchangeSaleId        String?      @db.Uuid
  approvalRequestId     String?      @db.Uuid
  number                String       @db.VarChar(60)
  status                ReturnStatus @default(DRAFT)
  reason                String       @db.VarChar(500)
  refundMethod          RefundMethod @default(ORIGINAL_METHOD)
  refundTotal           Decimal      @default(0) @db.Decimal(19, 4)
  storeCreditTotal      Decimal      @default(0) @db.Decimal(19, 4)
  taxTotal              Decimal      @default(0) @db.Decimal(19, 4)
  idempotencyKey        String       @db.VarChar(80)
  createdByMembershipId String       @db.Uuid
  acceptedAt            DateTime?    @db.Timestamptz(3)
  createdAt             DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime     @updatedAt @db.Timestamptz(3)

  business  Business           @relation(fields: [businessId], references: [id], onDelete: Restrict)
  branch    Branch             @relation(fields: [branchId, businessId], references: [id, businessId], onDelete: Restrict)
  sale      Sale               @relation(fields: [saleId, businessId], references: [id, businessId], onDelete: Restrict)
  shift     PosShift?          @relation(fields: [shiftId, businessId], references: [id, businessId], onDelete: Restrict)
  approval  ApprovalRequest?   @relation(fields: [approvalRequestId, businessId], references: [id, businessId], onDelete: Restrict)
  createdBy BusinessMembership @relation("ReturnCreatedBy", fields: [createdByMembershipId, businessId], references: [id, businessId], onDelete: Restrict)
  lines     SaleReturnLine[]
  payments  SalePayment[]
  credits   StoreCreditEntry[]

  @@unique([businessId, number])
  @@unique([businessId, idempotencyKey])
  @@unique([id, businessId])
  @@index([businessId, saleId])
  @@map("sale_returns")
}

/// CC-P2-009: return lines record quantity, money and stock disposition.
model SaleReturnLine {
  id           String           @id @default(uuid()) @db.Uuid
  businessId   String           @db.Uuid
  returnId     String           @db.Uuid
  saleLineId   String           @db.Uuid
  quantity     Decimal          @db.Decimal(19, 4)
  refundAmount Decimal          @default(0) @db.Decimal(19, 4)
  taxAmount    Decimal          @default(0) @db.Decimal(19, 4)
  disposition  StockDisposition @default(RESELLABLE)
  createdAt    DateTime         @default(now()) @db.Timestamptz(3)

  saleReturn SaleReturn @relation(fields: [returnId, businessId], references: [id, businessId], onDelete: Cascade)
  saleLine   SaleLine   @relation(fields: [saleLineId, businessId], references: [id, businessId], onDelete: Restrict)

  @@unique([businessId, returnId, saleLineId])
  @@index([businessId, saleLineId])
  @@map("sale_return_lines")
}

/// CC-P2-010 and CC-P4-010: store credit keeps an auditable balance per Customer.
model StoreCreditAccount {
  id           String   @id @default(uuid()) @db.Uuid
  businessId   String   @db.Uuid
  customerId   String   @db.Uuid
  currencyCode String   @db.Char(3)
  balance      Decimal  @default(0) @db.Decimal(19, 4)
  createdAt    DateTime @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @db.Timestamptz(3)

  business Business           @relation(fields: [businessId], references: [id], onDelete: Restrict)
  customer Customer           @relation(fields: [customerId, businessId], references: [id, businessId], onDelete: Restrict)
  entries  StoreCreditEntry[]

  @@unique([customerId, businessId])
  @@unique([id, businessId])
  @@index([businessId])
  @@map("store_credit_accounts")
}

/// CC-P2-010: every store-credit change keeps its reason and resulting balance.
model StoreCreditEntry {
  id                    String               @id @default(uuid()) @db.Uuid
  businessId            String               @db.Uuid
  accountId             String               @db.Uuid
  kind                  StoreCreditEntryKind
  amount                Decimal              @db.Decimal(19, 4)
  balanceAfter          Decimal              @db.Decimal(19, 4)
  reference             String?              @db.VarChar(120)
  saleId                String?              @db.Uuid
  returnId              String?              @db.Uuid
  createdByMembershipId String               @db.Uuid
  createdAt             DateTime             @default(now()) @db.Timestamptz(3)

  account    StoreCreditAccount @relation(fields: [accountId, businessId], references: [id, businessId], onDelete: Cascade)
  sale       Sale?              @relation(fields: [saleId, businessId], references: [id, businessId], onDelete: Restrict)
  saleReturn SaleReturn?        @relation(fields: [returnId, businessId], references: [id, businessId], onDelete: Restrict)
  createdBy  BusinessMembership @relation("StoreCreditCreatedBy", fields: [createdByMembershipId, businessId], references: [id, businessId], onDelete: Restrict)

  @@index([businessId, accountId, createdAt])
  @@map("store_credit_entries")
}

/// CC-P3-003: current stock position by Item, optional Variant and Location.
model StockBalance {
  id                String   @id @default(uuid()) @db.Uuid
  businessId        String   @db.Uuid
  locationId        String   @db.Uuid
  itemId            String   @db.Uuid
  variantId         String?  @db.Uuid
  onHandQuantity    Decimal  @default(0) @db.Decimal(19, 4)
  reservedQuantity  Decimal  @default(0) @db.Decimal(19, 4)
  incomingQuantity  Decimal  @default(0) @db.Decimal(19, 4)
  availableQuantity Decimal  @default(0) @db.Decimal(19, 4)
  updatedAt         DateTime @updatedAt @db.Timestamptz(3)

  business Business     @relation(fields: [businessId], references: [id], onDelete: Restrict)
  location Location     @relation(fields: [locationId, businessId], references: [id, businessId], onDelete: Restrict)
  item     Item         @relation(fields: [itemId, businessId], references: [id, businessId], onDelete: Restrict)
  variant  ItemVariant? @relation(fields: [variantId, businessId], references: [id, businessId], onDelete: Restrict)

  @@unique([businessId, locationId, itemId, variantId])
  @@unique([id, businessId])
  @@index([businessId, itemId])
  @@index([businessId, locationId])
  @@map("stock_balances")
}

/// CC-P3-001 and CC-P3-002: one physical stock movement creates one authoritative row.
model StockMovement {
  id                    String              @id @default(uuid()) @db.Uuid
  businessId            String              @db.Uuid
  branchId              String              @db.Uuid
  locationId            String              @db.Uuid
  itemId                String              @db.Uuid
  variantId             String?             @db.Uuid
  kind                  StockMovementKind
  status                StockMovementStatus @default(POSTED)
  quantity              Decimal             @db.Decimal(19, 4)
  unitCost              Decimal?            @db.Decimal(19, 4)
  reason                String              @db.VarChar(500)
  referenceType         String?             @db.VarChar(80)
  referenceId           String?             @db.VarChar(80)
  relatedMovementId     String?             @db.Uuid
  createdByMembershipId String              @db.Uuid
  occurredAt            DateTime            @default(now()) @db.Timestamptz(3)
  createdAt             DateTime            @default(now()) @db.Timestamptz(3)

  business  Business           @relation(fields: [businessId], references: [id], onDelete: Restrict)
  branch    Branch             @relation(fields: [branchId, businessId], references: [id, businessId], onDelete: Restrict)
  location  Location           @relation(fields: [locationId, businessId], references: [id, businessId], onDelete: Restrict)
  item      Item               @relation(fields: [itemId, businessId], references: [id, businessId], onDelete: Restrict)
  variant   ItemVariant?       @relation(fields: [variantId, businessId], references: [id, businessId], onDelete: Restrict)
  createdBy BusinessMembership @relation("StockMovementCreatedBy", fields: [createdByMembershipId, businessId], references: [id, businessId], onDelete: Restrict)

  @@unique([id, businessId])
  @@index([businessId, itemId, occurredAt])
  @@index([businessId, locationId, occurredAt])
  @@index([businessId, referenceType, referenceId])
  @@map("stock_movements")
}

/// CC-P3-006: a stock count freezes expected quantities before variance posting.
model StockCountSession {
  id                    String           @id @default(uuid()) @db.Uuid
  businessId            String           @db.Uuid
  branchId              String           @db.Uuid
  locationId            String           @db.Uuid
  number                String           @db.VarChar(60)
  name                  String           @db.VarChar(160)
  status                StockCountStatus @default(OPEN)
  varianceReason        String?          @db.VarChar(500)
  createdByMembershipId String           @db.Uuid
  postedByMembershipId  String?          @db.Uuid
  createdAt             DateTime         @default(now()) @db.Timestamptz(3)
  postedAt              DateTime?        @db.Timestamptz(3)
  updatedAt             DateTime         @updatedAt @db.Timestamptz(3)

  business  Business            @relation(fields: [businessId], references: [id], onDelete: Restrict)
  branch    Branch              @relation(fields: [branchId, businessId], references: [id, businessId], onDelete: Restrict)
  location  Location            @relation(fields: [locationId, businessId], references: [id, businessId], onDelete: Restrict)
  createdBy BusinessMembership  @relation("StockCountCreatedBy", fields: [createdByMembershipId, businessId], references: [id, businessId], onDelete: Restrict)
  postedBy  BusinessMembership? @relation("StockCountPostedBy", fields: [postedByMembershipId, businessId], references: [id, businessId], onDelete: Restrict)
  lines     StockCountLine[]

  @@unique([businessId, number])
  @@unique([id, businessId])
  @@index([businessId, status, createdAt])
  @@index([businessId, locationId, status])
  @@map("stock_count_sessions")
}

model StockCountLine {
  id               String   @id @default(uuid()) @db.Uuid
  businessId       String   @db.Uuid
  stockCountId     String   @db.Uuid
  itemId           String   @db.Uuid
  variantId        String?  @db.Uuid
  expectedQuantity Decimal  @db.Decimal(19, 4)
  countedQuantity  Decimal? @db.Decimal(19, 4)
  varianceQuantity Decimal? @db.Decimal(19, 4)
  note             String?  @db.VarChar(240)

  business   Business          @relation(fields: [businessId], references: [id], onDelete: Restrict)
  stockCount StockCountSession @relation(fields: [stockCountId, businessId], references: [id, businessId], onDelete: Cascade)
  item       Item              @relation(fields: [itemId, businessId], references: [id, businessId], onDelete: Restrict)
  variant    ItemVariant?      @relation(fields: [variantId, businessId], references: [id, businessId], onDelete: Restrict)

  @@unique([businessId, stockCountId, itemId, variantId])
  @@unique([id, businessId])
  @@index([businessId, itemId])
  @@map("stock_count_lines")
}

/// CC-P3-008: replenishment rule used to propose purchase quantities.
model ReorderSetting {
  id              String   @id @default(uuid()) @db.Uuid
  businessId      String   @db.Uuid
  locationId      String   @db.Uuid
  itemId          String   @db.Uuid
  variantId       String?  @db.Uuid
  minimumQuantity Decimal  @db.Decimal(19, 4)
  targetQuantity  Decimal  @db.Decimal(19, 4)
  createdAt       DateTime @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @db.Timestamptz(3)

  business Business     @relation(fields: [businessId], references: [id], onDelete: Restrict)
  location Location     @relation(fields: [locationId, businessId], references: [id, businessId], onDelete: Restrict)
  item     Item         @relation(fields: [itemId, businessId], references: [id, businessId], onDelete: Restrict)
  variant  ItemVariant? @relation(fields: [variantId, businessId], references: [id, businessId], onDelete: Restrict)

  @@unique([businessId, locationId, itemId, variantId])
  @@unique([id, businessId])
  @@index([businessId, itemId])
  @@map("reorder_settings")
}

/// CC-P3-009: purchase request records demand before supplier commitment.
model PurchaseRequest {
  id                    String                @id @default(uuid()) @db.Uuid
  businessId            String                @db.Uuid
  branchId              String                @db.Uuid
  number                String                @db.VarChar(60)
  status                PurchaseRequestStatus @default(SUBMITTED)
  reason                String                @db.VarChar(500)
  createdByMembershipId String                @db.Uuid
  createdAt             DateTime              @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime              @updatedAt @db.Timestamptz(3)
  approvedAt            DateTime?             @db.Timestamptz(3)

  business  Business              @relation(fields: [businessId], references: [id], onDelete: Restrict)
  branch    Branch                @relation(fields: [branchId, businessId], references: [id, businessId], onDelete: Restrict)
  createdBy BusinessMembership    @relation("PurchaseRequestCreatedBy", fields: [createdByMembershipId, businessId], references: [id, businessId], onDelete: Restrict)
  lines     PurchaseRequestLine[]
  orders    PurchaseOrder[]

  @@unique([businessId, number])
  @@unique([id, businessId])
  @@index([businessId, status, createdAt])
  @@map("purchase_requests")
}

model PurchaseRequestLine {
  id                String   @id @default(uuid()) @db.Uuid
  businessId        String   @db.Uuid
  purchaseRequestId String   @db.Uuid
  itemId            String   @db.Uuid
  variantId         String?  @db.Uuid
  quantity          Decimal  @db.Decimal(19, 4)
  expectedCost      Decimal? @db.Decimal(19, 4)
  note              String?  @db.VarChar(240)

  request PurchaseRequest @relation(fields: [purchaseRequestId, businessId], references: [id, businessId], onDelete: Cascade)
  item    Item            @relation(fields: [itemId, businessId], references: [id, businessId], onDelete: Restrict)
  variant ItemVariant?    @relation(fields: [variantId, businessId], references: [id, businessId], onDelete: Restrict)

  @@index([businessId, itemId])
  @@map("purchase_request_lines")
}

/// CC-P3-010 and CC-P3-011: PO quantities remain separate from receiving and billing.
model PurchaseOrder {
  id                    String              @id @default(uuid()) @db.Uuid
  businessId            String              @db.Uuid
  branchId              String              @db.Uuid
  supplierId            String              @db.Uuid
  purchaseRequestId     String?             @db.Uuid
  number                String              @db.VarChar(60)
  status                PurchaseOrderStatus @default(APPROVED)
  expectedDate          DateTime?           @db.Date
  notes                 String?             @db.VarChar(500)
  createdByMembershipId String              @db.Uuid
  createdAt             DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime            @updatedAt @db.Timestamptz(3)
  approvedAt            DateTime?           @db.Timestamptz(3)

  business      Business            @relation(fields: [businessId], references: [id], onDelete: Restrict)
  branch        Branch              @relation(fields: [branchId, businessId], references: [id, businessId], onDelete: Restrict)
  supplier      Supplier            @relation(fields: [supplierId, businessId], references: [id, businessId], onDelete: Restrict)
  request       PurchaseRequest?    @relation(fields: [purchaseRequestId, businessId], references: [id, businessId], onDelete: Restrict)
  createdBy     BusinessMembership  @relation("PurchaseOrderCreatedBy", fields: [createdByMembershipId, businessId], references: [id, businessId], onDelete: Restrict)
  lines         PurchaseOrderLine[]
  receipts      GoodsReceipt[]
  supplierBills SupplierBill[]

  @@unique([businessId, number])
  @@unique([id, businessId])
  @@index([businessId, supplierId, status])
  @@map("purchase_orders")
}

model PurchaseOrderLine {
  id               String  @id @default(uuid()) @db.Uuid
  businessId       String  @db.Uuid
  purchaseOrderId  String  @db.Uuid
  itemId           String  @db.Uuid
  variantId        String? @db.Uuid
  orderedQuantity  Decimal @db.Decimal(19, 4)
  receivedQuantity Decimal @default(0) @db.Decimal(19, 4)
  billedQuantity   Decimal @default(0) @db.Decimal(19, 4)
  returnedQuantity Decimal @default(0) @db.Decimal(19, 4)
  unitCost         Decimal @db.Decimal(19, 4)

  order        PurchaseOrder      @relation(fields: [purchaseOrderId, businessId], references: [id, businessId], onDelete: Cascade)
  item         Item               @relation(fields: [itemId, businessId], references: [id, businessId], onDelete: Restrict)
  variant      ItemVariant?       @relation(fields: [variantId, businessId], references: [id, businessId], onDelete: Restrict)
  receiptLines GoodsReceiptLine[]

  @@unique([id, businessId])
  @@index([businessId, itemId])
  @@map("purchase_order_lines")
}

model GoodsReceipt {
  id                    String   @id @default(uuid()) @db.Uuid
  businessId            String   @db.Uuid
  branchId              String   @db.Uuid
  locationId            String   @db.Uuid
  purchaseOrderId       String   @db.Uuid
  number                String   @db.VarChar(60)
  supplierDocument      String?  @db.VarChar(120)
  createdByMembershipId String   @db.Uuid
  receivedAt            DateTime @default(now()) @db.Timestamptz(3)
  createdAt             DateTime @default(now()) @db.Timestamptz(3)

  business  Business           @relation(fields: [businessId], references: [id], onDelete: Restrict)
  branch    Branch             @relation(fields: [branchId, businessId], references: [id, businessId], onDelete: Restrict)
  location  Location           @relation(fields: [locationId, businessId], references: [id, businessId], onDelete: Restrict)
  order     PurchaseOrder      @relation(fields: [purchaseOrderId, businessId], references: [id, businessId], onDelete: Restrict)
  createdBy BusinessMembership @relation("GoodsReceiptCreatedBy", fields: [createdByMembershipId, businessId], references: [id, businessId], onDelete: Restrict)
  lines     GoodsReceiptLine[]

  @@unique([businessId, number])
  @@unique([id, businessId])
  @@index([businessId, purchaseOrderId])
  @@map("goods_receipts")
}

model GoodsReceiptLine {
  id                  String  @id @default(uuid()) @db.Uuid
  businessId          String  @db.Uuid
  goodsReceiptId      String  @db.Uuid
  purchaseOrderLineId String  @db.Uuid
  itemId              String  @db.Uuid
  variantId           String? @db.Uuid
  receivedQuantity    Decimal @db.Decimal(19, 4)
  unitCost            Decimal @db.Decimal(19, 4)

  receipt   GoodsReceipt      @relation(fields: [goodsReceiptId, businessId], references: [id, businessId], onDelete: Cascade)
  orderLine PurchaseOrderLine @relation(fields: [purchaseOrderLineId, businessId], references: [id, businessId], onDelete: Restrict)
  item      Item              @relation(fields: [itemId, businessId], references: [id, businessId], onDelete: Restrict)
  variant   ItemVariant?      @relation(fields: [variantId, businessId], references: [id, businessId], onDelete: Restrict)

  @@index([businessId, itemId])
  @@map("goods_receipt_lines")
}

/// CC-P3-012: fulfillment preparation for orders that need pick, pack and dispatch.
model FulfillmentOrder {
  id                    String            @id @default(uuid()) @db.Uuid
  businessId            String            @db.Uuid
  branchId              String            @db.Uuid
  number                String            @db.VarChar(60)
  status                FulfillmentStatus @default(READY_TO_PICK)
  customerName          String?           @db.VarChar(180)
  sourceType            String            @db.VarChar(80)
  sourceId              String            @db.VarChar(80)
  createdByMembershipId String            @db.Uuid
  createdAt             DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime          @updatedAt @db.Timestamptz(3)
  dispatchedAt          DateTime?         @db.Timestamptz(3)

  business  Business           @relation(fields: [businessId], references: [id], onDelete: Restrict)
  branch    Branch             @relation(fields: [branchId, businessId], references: [id, businessId], onDelete: Restrict)
  createdBy BusinessMembership @relation("FulfillmentCreatedBy", fields: [createdByMembershipId, businessId], references: [id, businessId], onDelete: Restrict)
  lines     FulfillmentLine[]

  @@unique([businessId, number])
  @@unique([id, businessId])
  @@index([businessId, status, createdAt])
  @@map("fulfillment_orders")
}

model FulfillmentLine {
  id                 String  @id @default(uuid()) @db.Uuid
  businessId         String  @db.Uuid
  fulfillmentOrderId String  @db.Uuid
  itemId             String  @db.Uuid
  variantId          String? @db.Uuid
  quantity           Decimal @db.Decimal(19, 4)
  pickedQuantity     Decimal @default(0) @db.Decimal(19, 4)
  packedQuantity     Decimal @default(0) @db.Decimal(19, 4)

  fulfillment FulfillmentOrder @relation(fields: [fulfillmentOrderId, businessId], references: [id, businessId], onDelete: Cascade)
  item        Item             @relation(fields: [itemId, businessId], references: [id, businessId], onDelete: Restrict)
  variant     ItemVariant?     @relation(fields: [variantId, businessId], references: [id, businessId], onDelete: Restrict)

  @@index([businessId, itemId])
  @@map("fulfillment_lines")
}

/// CC-P4-001: posted customer invoices create receivables until collected.
model CustomerInvoice {
  id                    String                @id @default(uuid()) @db.Uuid
  businessId            String                @db.Uuid
  branchId              String?               @db.Uuid
  customerId            String                @db.Uuid
  number                String                @db.VarChar(60)
  status                CustomerInvoiceStatus @default(POSTED)
  currencyCode          String                @db.Char(3)
  totalAmount           Decimal               @db.Decimal(19, 4)
  paidAmount            Decimal               @default(0) @db.Decimal(19, 4)
  balanceAmount         Decimal               @db.Decimal(19, 4)
  dueDate               DateTime?             @db.Date
  notes                 String?               @db.VarChar(500)
  createdByMembershipId String                @db.Uuid
  postedAt              DateTime              @default(now()) @db.Timestamptz(3)
  createdAt             DateTime              @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime              @updatedAt @db.Timestamptz(3)

  business    Business                       @relation(fields: [businessId], references: [id], onDelete: Restrict)
  branch      Branch?                        @relation(fields: [branchId, businessId], references: [id, businessId], onDelete: Restrict)
  customer    Customer                       @relation(fields: [customerId, businessId], references: [id, businessId], onDelete: Restrict)
  createdBy   BusinessMembership             @relation("CustomerInvoiceCreatedBy", fields: [createdByMembershipId, businessId], references: [id, businessId], onDelete: Restrict)
  lines       CustomerInvoiceLine[]
  allocations CustomerCollectionAllocation[]

  @@unique([businessId, number])
  @@unique([id, businessId])
  @@index([businessId, customerId, status])
  @@index([businessId, dueDate])
  @@map("customer_invoices")
}

model CustomerInvoiceLine {
  id          String  @id @default(uuid()) @db.Uuid
  businessId  String  @db.Uuid
  invoiceId   String  @db.Uuid
  itemId      String? @db.Uuid
  description String  @db.VarChar(240)
  quantity    Decimal @db.Decimal(19, 4)
  unitPrice   Decimal @db.Decimal(19, 4)
  taxAmount   Decimal @default(0) @db.Decimal(19, 4)
  lineTotal   Decimal @db.Decimal(19, 4)

  invoice CustomerInvoice @relation(fields: [invoiceId, businessId], references: [id, businessId], onDelete: Cascade)
  item    Item?           @relation(fields: [itemId, businessId], references: [id, businessId], onDelete: Restrict)

  @@index([businessId, itemId])
  @@map("customer_invoice_lines")
}

/// CC-P4-003: collections are allocated explicitly so customer balances are explainable.
model CustomerCollection {
  id                    String   @id @default(uuid()) @db.Uuid
  businessId            String   @db.Uuid
  branchId              String?  @db.Uuid
  customerId            String   @db.Uuid
  amount                Decimal  @db.Decimal(19, 4)
  unallocatedAmount     Decimal  @default(0) @db.Decimal(19, 4)
  currencyCode          String   @db.Char(3)
  method                String   @db.VarChar(60)
  reference             String?  @db.VarChar(120)
  collectedAt           DateTime @default(now()) @db.Timestamptz(3)
  createdByMembershipId String   @db.Uuid
  createdAt             DateTime @default(now()) @db.Timestamptz(3)

  business    Business                       @relation(fields: [businessId], references: [id], onDelete: Restrict)
  branch      Branch?                        @relation(fields: [branchId, businessId], references: [id, businessId], onDelete: Restrict)
  customer    Customer                       @relation(fields: [customerId, businessId], references: [id, businessId], onDelete: Restrict)
  createdBy   BusinessMembership             @relation("CustomerCollectionCreatedBy", fields: [createdByMembershipId, businessId], references: [id, businessId], onDelete: Restrict)
  allocations CustomerCollectionAllocation[]

  @@unique([id, businessId])
  @@index([businessId, customerId, collectedAt])
  @@map("customer_collections")
}

model CustomerCollectionAllocation {
  id           String  @id @default(uuid()) @db.Uuid
  businessId   String  @db.Uuid
  collectionId String  @db.Uuid
  invoiceId    String  @db.Uuid
  amount       Decimal @db.Decimal(19, 4)

  collection CustomerCollection @relation(fields: [collectionId, businessId], references: [id, businessId], onDelete: Cascade)
  invoice    CustomerInvoice    @relation(fields: [invoiceId, businessId], references: [id, businessId], onDelete: Restrict)

  @@unique([businessId, collectionId, invoiceId])
  @@index([businessId, invoiceId])
  @@map("customer_collection_allocations")
}

/// CC-P4-004: posted supplier bills create payable balances until paid.
model SupplierBill {
  id                    String             @id @default(uuid()) @db.Uuid
  businessId            String             @db.Uuid
  branchId              String?            @db.Uuid
  supplierId            String             @db.Uuid
  purchaseOrderId       String?            @db.Uuid
  number                String             @db.VarChar(60)
  supplierDocument      String?            @db.VarChar(120)
  status                SupplierBillStatus @default(POSTED)
  currencyCode          String             @db.Char(3)
  totalAmount           Decimal            @db.Decimal(19, 4)
  paidAmount            Decimal            @default(0) @db.Decimal(19, 4)
  balanceAmount         Decimal            @db.Decimal(19, 4)
  dueDate               DateTime?          @db.Date
  notes                 String?            @db.VarChar(500)
  createdByMembershipId String             @db.Uuid
  postedAt              DateTime           @default(now()) @db.Timestamptz(3)
  createdAt             DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime           @updatedAt @db.Timestamptz(3)

  business      Business                    @relation(fields: [businessId], references: [id], onDelete: Restrict)
  branch        Branch?                     @relation(fields: [branchId, businessId], references: [id, businessId], onDelete: Restrict)
  supplier      Supplier                    @relation(fields: [supplierId, businessId], references: [id, businessId], onDelete: Restrict)
  purchaseOrder PurchaseOrder?              @relation(fields: [purchaseOrderId, businessId], references: [id, businessId], onDelete: Restrict)
  createdBy     BusinessMembership          @relation("SupplierBillCreatedBy", fields: [createdByMembershipId, businessId], references: [id, businessId], onDelete: Restrict)
  lines         SupplierBillLine[]
  allocations   SupplierPaymentAllocation[]

  @@unique([businessId, number])
  @@unique([id, businessId])
  @@index([businessId, supplierId, status])
  @@index([businessId, dueDate])
  @@map("supplier_bills")
}

model SupplierBillLine {
  id          String  @id @default(uuid()) @db.Uuid
  businessId  String  @db.Uuid
  billId      String  @db.Uuid
  itemId      String? @db.Uuid
  description String  @db.VarChar(240)
  quantity    Decimal @db.Decimal(19, 4)
  unitCost    Decimal @db.Decimal(19, 4)
  taxAmount   Decimal @default(0) @db.Decimal(19, 4)
  lineTotal   Decimal @db.Decimal(19, 4)

  bill SupplierBill @relation(fields: [billId, businessId], references: [id, businessId], onDelete: Cascade)
  item Item?        @relation(fields: [itemId, businessId], references: [id, businessId], onDelete: Restrict)

  @@index([businessId, itemId])
  @@map("supplier_bill_lines")
}

/// CC-P4-005: supplier payments reduce payable balances through explicit allocations.
model SupplierPayment {
  id                    String   @id @default(uuid()) @db.Uuid
  businessId            String   @db.Uuid
  branchId              String?  @db.Uuid
  supplierId            String   @db.Uuid
  amount                Decimal  @db.Decimal(19, 4)
  unallocatedAmount     Decimal  @default(0) @db.Decimal(19, 4)
  currencyCode          String   @db.Char(3)
  method                String   @db.VarChar(60)
  reference             String?  @db.VarChar(120)
  paidAt                DateTime @default(now()) @db.Timestamptz(3)
  createdByMembershipId String   @db.Uuid
  createdAt             DateTime @default(now()) @db.Timestamptz(3)

  business    Business                    @relation(fields: [businessId], references: [id], onDelete: Restrict)
  branch      Branch?                     @relation(fields: [branchId, businessId], references: [id, businessId], onDelete: Restrict)
  supplier    Supplier                    @relation(fields: [supplierId, businessId], references: [id, businessId], onDelete: Restrict)
  createdBy   BusinessMembership          @relation("SupplierPaymentCreatedBy", fields: [createdByMembershipId, businessId], references: [id, businessId], onDelete: Restrict)
  allocations SupplierPaymentAllocation[]

  @@unique([id, businessId])
  @@index([businessId, supplierId, paidAt])
  @@map("supplier_payments")
}

model SupplierPaymentAllocation {
  id         String  @id @default(uuid()) @db.Uuid
  businessId String  @db.Uuid
  paymentId  String  @db.Uuid
  billId     String  @db.Uuid
  amount     Decimal @db.Decimal(19, 4)

  payment SupplierPayment @relation(fields: [paymentId, businessId], references: [id, businessId], onDelete: Cascade)
  bill    SupplierBill    @relation(fields: [billId, businessId], references: [id, businessId], onDelete: Restrict)

  @@unique([businessId, paymentId, billId])
  @@index([businessId, billId])
  @@map("supplier_payment_allocations")
}

model ExpenseCategory {
  id         String       @id @default(uuid()) @db.Uuid
  businessId String       @db.Uuid
  code       String       @db.VarChar(50)
  name       String       @db.VarChar(120)
  status     RecordStatus @default(ACTIVE)
  createdAt  DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime     @updatedAt @db.Timestamptz(3)

  business Business  @relation(fields: [businessId], references: [id], onDelete: Restrict)
  expenses Expense[]

  @@unique([businessId, code])
  @@unique([id, businessId])
  @@index([businessId, status])
  @@map("expense_categories")
}

model Expense {
  id                    String        @id @default(uuid()) @db.Uuid
  businessId            String        @db.Uuid
  branchId              String?       @db.Uuid
  categoryId            String        @db.Uuid
  status                ExpenseStatus @default(POSTED)
  amount                Decimal       @db.Decimal(19, 4)
  taxAmount             Decimal       @default(0) @db.Decimal(19, 4)
  currencyCode          String        @db.Char(3)
  paymentMethod         String        @db.VarChar(60)
  spentAt               DateTime      @default(now()) @db.Timestamptz(3)
  supplierName          String?       @db.VarChar(180)
  description           String        @db.VarChar(240)
  attachmentUrl         String?       @db.VarChar(500)
  createdByMembershipId String        @db.Uuid
  createdAt             DateTime      @default(now()) @db.Timestamptz(3)

  business  Business           @relation(fields: [businessId], references: [id], onDelete: Restrict)
  branch    Branch?            @relation(fields: [branchId, businessId], references: [id, businessId], onDelete: Restrict)
  category  ExpenseCategory    @relation(fields: [categoryId, businessId], references: [id, businessId], onDelete: Restrict)
  createdBy BusinessMembership @relation("ExpenseCreatedBy", fields: [createdByMembershipId, businessId], references: [id, businessId], onDelete: Restrict)

  @@unique([id, businessId])
  @@index([businessId, categoryId, spentAt])
  @@map("expenses")
}

model BankAccount {
  id             String          @id @default(uuid()) @db.Uuid
  businessId     String          @db.Uuid
  code           String          @db.VarChar(50)
  name           String          @db.VarChar(120)
  type           BankAccountType
  currencyCode   String          @db.Char(3)
  openingBalance Decimal         @default(0) @db.Decimal(19, 4)
  currentBalance Decimal         @default(0) @db.Decimal(19, 4)
  status         RecordStatus    @default(ACTIVE)
  createdAt      DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime        @updatedAt @db.Timestamptz(3)

  business     Business          @relation(fields: [businessId], references: [id], onDelete: Restrict)
  transactions BankTransaction[]

  @@unique([businessId, code])
  @@unique([id, businessId])
  @@index([businessId, status])
  @@map("bank_accounts")
}

model BankTransaction {
  id                    String              @id @default(uuid()) @db.Uuid
  businessId            String              @db.Uuid
  branchId              String?             @db.Uuid
  accountId             String              @db.Uuid
  kind                  BankTransactionKind
  amount                Decimal             @db.Decimal(19, 4)
  currencyCode          String              @db.Char(3)
  reference             String?             @db.VarChar(120)
  description           String              @db.VarChar(240)
  occurredAt            DateTime            @default(now()) @db.Timestamptz(3)
  createdByMembershipId String              @db.Uuid
  createdAt             DateTime            @default(now()) @db.Timestamptz(3)

  business  Business           @relation(fields: [businessId], references: [id], onDelete: Restrict)
  branch    Branch?            @relation(fields: [branchId, businessId], references: [id, businessId], onDelete: Restrict)
  account   BankAccount        @relation(fields: [accountId, businessId], references: [id, businessId], onDelete: Restrict)
  createdBy BusinessMembership @relation("BankTransactionCreatedBy", fields: [createdByMembershipId, businessId], references: [id, businessId], onDelete: Restrict)

  @@unique([id, businessId])
  @@index([businessId, accountId, occurredAt])
  @@map("bank_transactions")
}

model LoyaltyAccount {
  id             String   @id @default(uuid()) @db.Uuid
  businessId     String   @db.Uuid
  customerId     String   @db.Uuid
  pointsBalance  Decimal  @default(0) @db.Decimal(19, 4)
  tier           String   @default("STANDARD") @db.VarChar(80)
  lastActivityAt DateTime @default(now()) @db.Timestamptz(3)
  createdAt      DateTime @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @db.Timestamptz(3)

  business Business       @relation(fields: [businessId], references: [id], onDelete: Restrict)
  customer Customer       @relation(fields: [customerId, businessId], references: [id, businessId], onDelete: Restrict)
  entries  LoyaltyEntry[]

  @@unique([customerId, businessId])
  @@unique([id, businessId])
  @@index([businessId, tier])
  @@map("loyalty_accounts")
}

model LoyaltyEntry {
  id                    String           @id @default(uuid()) @db.Uuid
  businessId            String           @db.Uuid
  accountId             String           @db.Uuid
  customerId            String           @db.Uuid
  kind                  LoyaltyEntryKind
  points                Decimal          @db.Decimal(19, 4)
  resultingBalance      Decimal          @db.Decimal(19, 4)
  reference             String?          @db.VarChar(120)
  reason                String           @db.VarChar(240)
  expiresAt             DateTime?        @db.Timestamptz(3)
  createdByMembershipId String           @db.Uuid
  createdAt             DateTime         @default(now()) @db.Timestamptz(3)

  business  Business           @relation(fields: [businessId], references: [id], onDelete: Restrict)
  account   LoyaltyAccount     @relation(fields: [accountId, businessId], references: [id, businessId], onDelete: Cascade)
  customer  Customer           @relation(fields: [customerId, businessId], references: [id, businessId], onDelete: Restrict)
  createdBy BusinessMembership @relation("LoyaltyEntryCreatedBy", fields: [createdByMembershipId, businessId], references: [id, businessId], onDelete: Restrict)

  @@index([businessId, customerId, createdAt])
  @@map("loyalty_entries")
}

/// CC-P4-012: posted finance actions emit accounting events for optional accounting integration.
model AccountingEvent {
  id           String                @id @default(uuid()) @db.Uuid
  businessId   String                @db.Uuid
  sourceType   String                @db.VarChar(80)
  sourceId     String                @db.VarChar(80)
  eventType    String                @db.VarChar(120)
  amount       Decimal?              @db.Decimal(19, 4)
  currencyCode String?               @db.Char(3)
  payload      Json
  status       AccountingEventStatus @default(PENDING)
  createdAt    DateTime              @default(now()) @db.Timestamptz(3)
  exportedAt   DateTime?             @db.Timestamptz(3)

  business Business @relation(fields: [businessId], references: [id], onDelete: Restrict)

  @@unique([businessId, sourceType, sourceId, eventType])
  @@index([businessId, status, createdAt])
  @@map("accounting_events")
}

/// CC-P5-001: reusable workflow statuses can be shared by tickets, bookings and later vertical packs.
model WorkflowStatus {
  id         String       @id @default(uuid()) @db.Uuid
  businessId String       @db.Uuid
  code       String       @db.VarChar(50)
  name       String       @db.VarChar(120)
  appliesTo  String       @db.VarChar(80)
  sortOrder  Int          @default(0)
  isFinal    Boolean      @default(false)
  status     RecordStatus @default(ACTIVE)
  createdAt  DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime     @updatedAt @db.Timestamptz(3)

  business Business @relation(fields: [businessId], references: [id], onDelete: Restrict)

  @@unique([businessId, appliesTo, code])
  @@unique([id, businessId])
  @@index([businessId, appliesTo, status])
  @@map("workflow_statuses")
}

model WorkflowTransition {
  id                 String                   @id @default(uuid()) @db.Uuid
  businessId         String                   @db.Uuid
  appliesTo          String                   @db.VarChar(80)
  fromStatusCode     String                   @db.VarChar(50)
  toStatusCode       String                   @db.VarChar(50)
  requiredPermission String?                  @db.VarChar(80)
  requiresApproval   Boolean                  @default(false)
  status             WorkflowTransitionStatus @default(ACTIVE)
  createdAt          DateTime                 @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime                 @updatedAt @db.Timestamptz(3)

  business Business @relation(fields: [businessId], references: [id], onDelete: Restrict)

  @@unique([businessId, appliesTo, fromStatusCode, toStatusCode])
  @@index([businessId, appliesTo, status])
  @@map("workflow_transitions")
}

/// CC-P5-002: one work-ticket engine for service, repair, production and operations work.
model WorkTicket {
  id                    String             @id @default(uuid()) @db.Uuid
  businessId            String             @db.Uuid
  branchId              String?            @db.Uuid
  number                String             @db.VarChar(60)
  title                 String             @db.VarChar(180)
  description           String?            @db.VarChar(1000)
  status                WorkTicketStatus   @default(OPEN)
  priority              WorkTicketPriority @default(NORMAL)
  sourceType            String?            @db.VarChar(80)
  sourceId              String?            @db.VarChar(80)
  assigneeMembershipId  String?            @db.Uuid
  checklist             Json?
  dueAt                 DateTime?          @db.Timestamptz(3)
  completedAt           DateTime?          @db.Timestamptz(3)
  createdByMembershipId String             @db.Uuid
  createdAt             DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime           @updatedAt @db.Timestamptz(3)

  business  Business           @relation(fields: [businessId], references: [id], onDelete: Restrict)
  branch    Branch?            @relation(fields: [branchId, businessId], references: [id, businessId], onDelete: Restrict)
  createdBy BusinessMembership @relation("WorkTicketCreatedBy", fields: [createdByMembershipId, businessId], references: [id, businessId], onDelete: Restrict)

  @@unique([businessId, number])
  @@unique([id, businessId])
  @@index([businessId, status, priority])
  @@index([businessId, sourceType, sourceId])
  @@map("work_tickets")
}

/// CC-P5-003: reusable booking records reserve time/resource capacity without creating sales or stock movement.
model Booking {
  id                    String        @id @default(uuid()) @db.Uuid
  businessId            String        @db.Uuid
  branchId              String        @db.Uuid
  customerId            String?       @db.Uuid
  number                String        @db.VarChar(60)
  resourceCode          String        @db.VarChar(80)
  title                 String        @db.VarChar(180)
  status                BookingStatus @default(CONFIRMED)
  startsAt              DateTime      @db.Timestamptz(3)
  endsAt                DateTime      @db.Timestamptz(3)
  capacityUsed          Int           @default(1)
  depositAmount         Decimal       @default(0) @db.Decimal(19, 4)
  notes                 String?       @db.VarChar(500)
  createdByMembershipId String        @db.Uuid
  createdAt             DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime      @updatedAt @db.Timestamptz(3)

  business  Business           @relation(fields: [businessId], references: [id], onDelete: Restrict)
  branch    Branch             @relation(fields: [branchId, businessId], references: [id, businessId], onDelete: Restrict)
  customer  Customer?          @relation(fields: [customerId, businessId], references: [id, businessId], onDelete: Restrict)
  createdBy BusinessMembership @relation("BookingCreatedBy", fields: [createdByMembershipId, businessId], references: [id, businessId], onDelete: Restrict)

  @@unique([businessId, number])
  @@unique([id, businessId])
  @@index([businessId, branchId, resourceCode, startsAt, endsAt])
  @@index([businessId, status, startsAt])
  @@map("bookings")
}

/// CC-P5-004: customer-owned assets such as vehicles, devices or equipment.
model CustomerAsset {
  id         String       @id @default(uuid()) @db.Uuid
  businessId String       @db.Uuid
  customerId String       @db.Uuid
  code       String       @db.VarChar(60)
  name       String       @db.VarChar(180)
  assetType  String       @db.VarChar(80)
  identifier String?      @db.VarChar(120)
  attributes Json?
  status     RecordStatus @default(ACTIVE)
  createdAt  DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime     @updatedAt @db.Timestamptz(3)

  business Business @relation(fields: [businessId], references: [id], onDelete: Restrict)
  customer Customer @relation(fields: [customerId, businessId], references: [id, businessId], onDelete: Restrict)

  @@unique([businessId, code])
  @@unique([id, businessId])
  @@index([businessId, customerId])
  @@map("customer_assets")
}

/// CC-P5-005: exact-unit traceability for serial, IMEI, batch, lot and expiry-controlled items.
model TraceableUnit {
  id              String              @id @default(uuid()) @db.Uuid
  businessId      String              @db.Uuid
  itemId          String              @db.Uuid
  variantId       String?             @db.Uuid
  locationId      String?             @db.Uuid
  serialNumber    String?             @db.VarChar(120)
  batchNumber     String?             @db.VarChar(120)
  lotNumber       String?             @db.VarChar(120)
  imei            String?             @db.VarChar(120)
  manufactureDate DateTime?           @db.Date
  expiryDate      DateTime?           @db.Date
  status          TraceableUnitStatus @default(AVAILABLE)
  sourceType      String?             @db.VarChar(80)
  sourceId        String?             @db.VarChar(80)
  createdAt       DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime            @updatedAt @db.Timestamptz(3)

  business Business     @relation(fields: [businessId], references: [id], onDelete: Restrict)
  item     Item         @relation(fields: [itemId, businessId], references: [id, businessId], onDelete: Restrict)
  variant  ItemVariant? @relation(fields: [variantId, businessId], references: [id, businessId], onDelete: Restrict)
  location Location?    @relation(fields: [locationId, businessId], references: [id, businessId], onDelete: Restrict)

  @@unique([businessId, serialNumber])
  @@unique([businessId, imei])
  @@unique([id, businessId])
  @@index([businessId, itemId, status])
  @@index([businessId, batchNumber])
  @@index([businessId, expiryDate])
  @@map("traceable_units")
}

model WarrantyPolicy {
  id           String       @id @default(uuid()) @db.Uuid
  businessId   String       @db.Uuid
  code         String       @db.VarChar(50)
  name         String       @db.VarChar(120)
  durationDays Int
  terms        String?      @db.VarChar(1000)
  status       RecordStatus @default(ACTIVE)
  createdAt    DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime     @updatedAt @db.Timestamptz(3)

  business Business @relation(fields: [businessId], references: [id], onDelete: Restrict)

  @@unique([businessId, code])
  @@unique([id, businessId])
  @@map("warranty_policies")
}

/// CC-P5-006: warranty/RMA claims have lifecycle history without directly changing stock or finance.
model WarrantyClaim {
  id                    String              @id @default(uuid()) @db.Uuid
  businessId            String              @db.Uuid
  customerId            String?             @db.Uuid
  number                String              @db.VarChar(60)
  status                WarrantyClaimStatus @default(OPEN)
  itemDescription       String              @db.VarChar(240)
  serialReference       String?             @db.VarChar(120)
  issue                 String              @db.VarChar(1000)
  resolution            String?             @db.VarChar(1000)
  createdByMembershipId String              @db.Uuid
  openedAt              DateTime            @default(now()) @db.Timestamptz(3)
  closedAt              DateTime?           @db.Timestamptz(3)
  updatedAt             DateTime            @updatedAt @db.Timestamptz(3)

  business  Business           @relation(fields: [businessId], references: [id], onDelete: Restrict)
  customer  Customer?          @relation(fields: [customerId, businessId], references: [id, businessId], onDelete: Restrict)
  createdBy BusinessMembership @relation("WarrantyClaimCreatedBy", fields: [createdByMembershipId, businessId], references: [id, businessId], onDelete: Restrict)

  @@unique([businessId, number])
  @@unique([id, businessId])
  @@index([businessId, status, openedAt])
  @@map("warranty_claims")
}

/// CC-P5-007: recipe/BOM definitions do not mutate stock until a consumption record is posted.
model Bom {
  id             String    @id @default(uuid()) @db.Uuid
  businessId     String    @db.Uuid
  code           String    @db.VarChar(60)
  name           String    @db.VarChar(180)
  outputItemId   String    @db.Uuid
  outputQuantity Decimal   @db.Decimal(19, 4)
  status         BomStatus @default(DRAFT)
  notes          String?   @db.VarChar(500)
  createdAt      DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @db.Timestamptz(3)

  business   Business       @relation(fields: [businessId], references: [id], onDelete: Restrict)
  outputItem Item           @relation(fields: [outputItemId, businessId], references: [id, businessId], onDelete: Restrict)
  components BomComponent[]

  @@unique([businessId, code])
  @@unique([id, businessId])
  @@index([businessId, status])
  @@map("boms")
}

model BomComponent {
  id             String  @id @default(uuid()) @db.Uuid
  businessId     String  @db.Uuid
  bomId          String  @db.Uuid
  itemId         String  @db.Uuid
  variantId      String? @db.Uuid
  quantity       Decimal @db.Decimal(19, 4)
  wastagePercent Decimal @default(0) @db.Decimal(9, 4)

  bom     Bom          @relation(fields: [bomId, businessId], references: [id, businessId], onDelete: Cascade)
  item    Item         @relation(fields: [itemId, businessId], references: [id, businessId], onDelete: Restrict)
  variant ItemVariant? @relation(fields: [variantId, businessId], references: [id, businessId], onDelete: Restrict)

  @@index([businessId, itemId])
  @@map("bom_components")
}

/// CC-P5-008: material usage is posted once against a real execution record.
model MaterialConsumption {
  id                    String   @id @default(uuid()) @db.Uuid
  businessId            String   @db.Uuid
  itemId                String   @db.Uuid
  variantId             String?  @db.Uuid
  quantity              Decimal  @db.Decimal(19, 4)
  sourceType            String   @db.VarChar(80)
  sourceId              String   @db.VarChar(80)
  notes                 String?  @db.VarChar(500)
  createdByMembershipId String   @db.Uuid
  consumedAt            DateTime @default(now()) @db.Timestamptz(3)

  business  Business           @relation(fields: [businessId], references: [id], onDelete: Restrict)
  item      Item               @relation(fields: [itemId, businessId], references: [id, businessId], onDelete: Restrict)
  variant   ItemVariant?       @relation(fields: [variantId, businessId], references: [id, businessId], onDelete: Restrict)
  createdBy BusinessMembership @relation("MaterialConsumptionCreatedBy", fields: [createdByMembershipId, businessId], references: [id, businessId], onDelete: Restrict)

  @@unique([businessId, sourceType, sourceId, itemId, variantId])
  @@index([businessId, itemId, consumedAt])
  @@map("material_consumptions")
}

/// CC-P5-009 and CC-P5-010: route and delivery records plan delivery without moving stock.
model DeliveryRoute {
  id                    String   @id @default(uuid()) @db.Uuid
  businessId            String   @db.Uuid
  branchId              String   @db.Uuid
  code                  String   @db.VarChar(60)
  name                  String   @db.VarChar(180)
  vehicleReference      String?  @db.VarChar(120)
  driverName            String?  @db.VarChar(120)
  plannedDate           DateTime @db.Date
  createdByMembershipId String   @db.Uuid
  createdAt             DateTime @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime @updatedAt @db.Timestamptz(3)

  business  Business           @relation(fields: [businessId], references: [id], onDelete: Restrict)
  branch    Branch             @relation(fields: [branchId, businessId], references: [id, businessId], onDelete: Restrict)
  createdBy BusinessMembership @relation("DeliveryRouteCreatedBy", fields: [createdByMembershipId, businessId], references: [id, businessId], onDelete: Restrict)
  stops     DeliveryStop[]

  @@unique([businessId, code])
  @@unique([id, businessId])
  @@index([businessId, branchId, plannedDate])
  @@map("delivery_routes")
}

model DeliveryStop {
  id             String         @id @default(uuid()) @db.Uuid
  businessId     String         @db.Uuid
  routeId        String         @db.Uuid
  branchId       String         @db.Uuid
  sequence       Int
  customerName   String         @db.VarChar(180)
  address        Json?
  sourceType     String?        @db.VarChar(80)
  sourceId       String?        @db.VarChar(80)
  status         DeliveryStatus @default(PLANNED)
  proofReference String?        @db.VarChar(240)
  failedReason   String?        @db.VarChar(240)
  completedAt    DateTime?      @db.Timestamptz(3)
  createdAt      DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime       @updatedAt @db.Timestamptz(3)

  business Business      @relation(fields: [businessId], references: [id], onDelete: Restrict)
  branch   Branch        @relation(fields: [branchId, businessId], references: [id, businessId], onDelete: Restrict)
  route    DeliveryRoute @relation(fields: [routeId, businessId], references: [id, businessId], onDelete: Cascade)

  @@unique([businessId, routeId, sequence])
  @@unique([id, businessId])
  @@index([businessId, status, createdAt])
  @@map("delivery_stops")
}

/// CC-P5-011: notification events are queued with reason, recipient and delivery state.
model NotificationEvent {
  id                    String             @id @default(uuid()) @db.Uuid
  businessId            String             @db.Uuid
  channel               String             @db.VarChar(40)
  recipient             String             @db.VarChar(254)
  subject               String             @db.VarChar(180)
  body                  String             @db.VarChar(1000)
  status                NotificationStatus @default(PENDING)
  sourceType            String?            @db.VarChar(80)
  sourceId              String?            @db.VarChar(80)
  createdByMembershipId String?            @db.Uuid
  createdAt             DateTime           @default(now()) @db.Timestamptz(3)
  sentAt                DateTime?          @db.Timestamptz(3)

  business  Business            @relation(fields: [businessId], references: [id], onDelete: Restrict)
  createdBy BusinessMembership? @relation("NotificationCreatedBy", fields: [createdByMembershipId, businessId], references: [id, businessId], onDelete: Restrict)

  @@index([businessId, status, createdAt])
  @@index([businessId, sourceType, sourceId])
  @@map("notification_events")
}

/// CC-P5-012: document metadata links files/photos to business records without storing binary data in Postgres.
model BusinessDocument {
  id                    String   @id @default(uuid()) @db.Uuid
  businessId            String   @db.Uuid
  entityType            String   @db.VarChar(80)
  entityId              String   @db.VarChar(80)
  fileName              String   @db.VarChar(240)
  mimeType              String   @db.VarChar(120)
  url                   String   @db.VarChar(1000)
  notes                 String?  @db.VarChar(500)
  createdByMembershipId String   @db.Uuid
  createdAt             DateTime @default(now()) @db.Timestamptz(3)

  business  Business           @relation(fields: [businessId], references: [id], onDelete: Restrict)
  createdBy BusinessMembership @relation("DocumentCreatedBy", fields: [createdByMembershipId, businessId], references: [id, businessId], onDelete: Restrict)

  @@index([businessId, entityType, entityId])
  @@map("business_documents")
}

/// CC-P6-001 to CC-P6-003 and CC-P6-008: store terminals and connected hardware.
model StoreDevice {
  id                       String       @id @default(uuid()) @db.Uuid
  businessId               String       @db.Uuid
  branchId                 String?      @db.Uuid
  code                     String       @db.VarChar(60)
  name                     String       @db.VarChar(120)
  kind                     DeviceKind
  status                   DeviceStatus @default(REGISTERED)
  hardwareId               String?      @db.VarChar(160)
  capabilities             Json?
  lastSeenAt               DateTime?    @db.Timestamptz(3)
  pendingOfflineItems      Int          @default(0)
  registeredByMembershipId String       @db.Uuid
  createdAt                DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt                DateTime     @updatedAt @db.Timestamptz(3)

  business     Business           @relation(fields: [businessId], references: [id], onDelete: Restrict)
  branch       Branch?            @relation(fields: [branchId, businessId], references: [id, businessId], onDelete: Restrict)
  registeredBy BusinessMembership @relation("DeviceRegisteredBy", fields: [registeredByMembershipId, businessId], references: [id, businessId], onDelete: Restrict)
  queueItems   OfflineQueueItem[]

  @@unique([businessId, code])
  @@unique([id, businessId])
  @@index([businessId, branchId, status])
  @@map("store_devices")
}

/// CC-P6-004 to CC-P6-007: queued offline actions are idempotent and reviewed on sync.
model OfflineQueueItem {
  id                    String             @id @default(uuid()) @db.Uuid
  businessId            String             @db.Uuid
  branchId              String?            @db.Uuid
  deviceId              String?            @db.Uuid
  idempotencyKey        String             @db.VarChar(120)
  operationType         String             @db.VarChar(120)
  payload               Json
  status                OfflineQueueStatus @default(QUEUED)
  riskLevel             String             @default("NORMAL") @db.VarChar(40)
  failureReason         String?            @db.VarChar(500)
  createdByMembershipId String             @db.Uuid
  createdAt             DateTime           @default(now()) @db.Timestamptz(3)
  syncedAt              DateTime?          @db.Timestamptz(3)

  business  Business           @relation(fields: [businessId], references: [id], onDelete: Restrict)
  branch    Branch?            @relation(fields: [branchId, businessId], references: [id, businessId], onDelete: Restrict)
  device    StoreDevice?       @relation(fields: [deviceId, businessId], references: [id, businessId], onDelete: Restrict)
  createdBy BusinessMembership @relation("OfflineQueueCreatedBy", fields: [createdByMembershipId, businessId], references: [id, businessId], onDelete: Restrict)
  conflicts SyncConflict[]

  @@unique([businessId, idempotencyKey])
  @@unique([id, businessId])
  @@index([businessId, status, createdAt])
  @@index([businessId, deviceId, status])
  @@map("offline_queue_items")
}

model SyncConflict {
  id                     String             @id @default(uuid()) @db.Uuid
  businessId             String             @db.Uuid
  queueItemId            String             @db.Uuid
  entityType             String             @db.VarChar(80)
  entityId               String?            @db.VarChar(80)
  reason                 String             @db.VarChar(500)
  serverSnapshot         Json?
  clientSnapshot         Json?
  status                 SyncConflictStatus @default(OPEN)
  resolution             String?            @db.VarChar(500)
  resolvedByMembershipId String?            @db.Uuid
  createdAt              DateTime           @default(now()) @db.Timestamptz(3)
  resolvedAt             DateTime?          @db.Timestamptz(3)

  business   Business            @relation(fields: [businessId], references: [id], onDelete: Restrict)
  queueItem  OfflineQueueItem    @relation(fields: [queueItemId, businessId], references: [id, businessId], onDelete: Cascade)
  resolvedBy BusinessMembership? @relation("SyncConflictResolvedBy", fields: [resolvedByMembershipId, businessId], references: [id, businessId], onDelete: Restrict)

  @@unique([id, businessId])
  @@index([businessId, status, createdAt])
  @@map("sync_conflicts")
}

/// CC-P7-001 to CC-P7-005: saved report views store reusable filters without mutating source records.
model SavedReportView {
  id                    String   @id @default(uuid()) @db.Uuid
  businessId            String   @db.Uuid
  code                  String   @db.VarChar(80)
  name                  String   @db.VarChar(160)
  reportType            String   @db.VarChar(80)
  filters               Json
  columns               Json?
  createdByMembershipId String   @db.Uuid
  createdAt             DateTime @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime @updatedAt @db.Timestamptz(3)

  business  Business           @relation(fields: [businessId], references: [id], onDelete: Restrict)
  createdBy BusinessMembership @relation("ReportViewCreatedBy", fields: [createdByMembershipId, businessId], references: [id, businessId], onDelete: Restrict)

  @@unique([businessId, code])
  @@unique([id, businessId])
  @@index([businessId, reportType])
  @@map("saved_report_views")
}

/// CC-P7-009: export requests are auditable and separate from report calculation.
model DataExportRequest {
  id                      String           @id @default(uuid()) @db.Uuid
  businessId              String           @db.Uuid
  exportType              String           @db.VarChar(80)
  format                  String           @db.VarChar(20)
  filters                 Json?
  status                  DataExportStatus @default(QUEUED)
  fileUrl                 String?          @db.VarChar(1000)
  failureReason           String?          @db.VarChar(500)
  requestedByMembershipId String           @db.Uuid
  requestedAt             DateTime         @default(now()) @db.Timestamptz(3)
  completedAt             DateTime?        @db.Timestamptz(3)
  expiresAt               DateTime?        @db.Timestamptz(3)

  business    Business           @relation(fields: [businessId], references: [id], onDelete: Restrict)
  requestedBy BusinessMembership @relation("DataExportRequestedBy", fields: [requestedByMembershipId, businessId], references: [id, businessId], onDelete: Restrict)

  @@unique([id, businessId])
  @@index([businessId, exportType, status])
  @@map("data_export_requests")
}

/// CC-P7-007: webhook subscriptions define signed event delivery targets.
model WebhookSubscription {
  id          String                    @id @default(uuid()) @db.Uuid
  businessId  String                    @db.Uuid
  name        String                    @db.VarChar(160)
  endpointUrl String                    @db.VarChar(1000)
  eventTypes  Json
  secretHint  String?                   @db.VarChar(120)
  status      WebhookSubscriptionStatus @default(ACTIVE)
  createdAt   DateTime                  @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime                  @updatedAt @db.Timestamptz(3)

  business   Business          @relation(fields: [businessId], references: [id], onDelete: Restrict)
  deliveries WebhookDelivery[]

  @@unique([id, businessId])
  @@index([businessId, status])
  @@map("webhook_subscriptions")
}

/// CC-P7-008: webhook delivery attempts are retryable and can become operator-visible failures.
model WebhookDelivery {
  id             String                @id @default(uuid()) @db.Uuid
  businessId     String                @db.Uuid
  subscriptionId String                @db.Uuid
  eventId        String                @db.VarChar(120)
  eventType      String                @db.VarChar(120)
  payload        Json
  status         WebhookDeliveryStatus @default(PENDING)
  attempts       Int                   @default(0)
  nextAttemptAt  DateTime?             @db.Timestamptz(3)
  lastError      String?               @db.VarChar(500)
  createdAt      DateTime              @default(now()) @db.Timestamptz(3)
  deliveredAt    DateTime?             @db.Timestamptz(3)

  business     Business            @relation(fields: [businessId], references: [id], onDelete: Restrict)
  subscription WebhookSubscription @relation(fields: [subscriptionId, businessId], references: [id, businessId], onDelete: Cascade)

  @@unique([businessId, subscriptionId, eventId])
  @@unique([id, businessId])
  @@index([businessId, status, nextAttemptAt])
  @@map("webhook_deliveries")
}

/// CC-P7-010: migration validation previews totals/errors before any final import commit.
model MigrationValidation {
  id                    String                    @id @default(uuid()) @db.Uuid
  businessId            String                    @db.Uuid
  sourceName            String                    @db.VarChar(180)
  entityKind            ImportEntityKind
  status                MigrationValidationStatus @default(RECEIVED)
  totalRows             Int                       @default(0)
  validRows             Int                       @default(0)
  invalidRows           Int                       @default(0)
  warningRows           Int                       @default(0)
  errors                Json?
  preview               Json?
  reconciliation        Json?
  createdByMembershipId String                    @db.Uuid
  createdAt             DateTime                  @default(now()) @db.Timestamptz(3)
  approvedAt            DateTime?                 @db.Timestamptz(3)

  business  Business           @relation(fields: [businessId], references: [id], onDelete: Restrict)
  createdBy BusinessMembership @relation("MigrationValidationCreatedBy", fields: [createdByMembershipId, businessId], references: [id, businessId], onDelete: Restrict)

  @@unique([id, businessId])
  @@index([businessId, entityKind, status])
  @@map("migration_validations")
}

/// CC-P8-001 to CC-P8-003: security events make sensitive activity visible to operators.
model SecurityEvent {
  id                     String                @id @default(uuid()) @db.Uuid
  businessId             String                @db.Uuid
  eventType              String                @db.VarChar(120)
  severity               SecurityEventSeverity @default(INFO)
  subjectType            String?               @db.VarChar(80)
  subjectId              String?               @db.VarChar(80)
  detail                 String                @db.VarChar(500)
  metadata               Json?
  recordedByMembershipId String?               @db.Uuid
  occurredAt             DateTime              @default(now()) @db.Timestamptz(3)

  business   Business            @relation(fields: [businessId], references: [id], onDelete: Restrict)
  recordedBy BusinessMembership? @relation("SecurityEventRecordedBy", fields: [recordedByMembershipId, businessId], references: [id, businessId], onDelete: Restrict)

  @@unique([id, businessId])
  @@index([businessId, severity, occurredAt])
  @@map("security_events")
}

/// CC-P8-004 and CC-P8-005: backup records and restore-test evidence.
model BackupRun {
  id                     String          @id @default(uuid()) @db.Uuid
  businessId             String          @db.Uuid
  scope                  String          @db.VarChar(120)
  status                 BackupRunStatus @default(SCHEDULED)
  storageReference       String?         @db.VarChar(500)
  sizeBytes              BigInt?
  recoveryPointObjective String?         @db.VarChar(80)
  recoveryTimeObjective  String?         @db.VarChar(80)
  restoreTestedAt        DateTime?       @db.Timestamptz(3)
  failureReason          String?         @db.VarChar(500)
  recordedByMembershipId String?         @db.Uuid
  startedAt              DateTime        @default(now()) @db.Timestamptz(3)
  completedAt            DateTime?       @db.Timestamptz(3)

  business   Business            @relation(fields: [businessId], references: [id], onDelete: Restrict)
  recordedBy BusinessMembership? @relation("BackupRunRecordedBy", fields: [recordedByMembershipId, businessId], references: [id, businessId], onDelete: Restrict)

  @@unique([id, businessId])
  @@index([businessId, status, startedAt])
  @@map("backup_runs")
}

/// CC-P8-006 to CC-P8-008 and CC-P8-010: operational checks for go-live readiness.
model ReadinessCheck {
  id                     String               @id @default(uuid()) @db.Uuid
  businessId             String               @db.Uuid
  area                   String               @db.VarChar(80)
  name                   String               @db.VarChar(160)
  status                 ReadinessCheckStatus @default(NOT_RUN)
  target                 String?              @db.VarChar(120)
  measuredValue          String?              @db.VarChar(120)
  notes                  String?              @db.VarChar(500)
  recordedByMembershipId String?              @db.Uuid
  checkedAt              DateTime             @default(now()) @db.Timestamptz(3)

  business   Business            @relation(fields: [businessId], references: [id], onDelete: Restrict)
  recordedBy BusinessMembership? @relation("ReadinessCheckRecordedBy", fields: [recordedByMembershipId, businessId], references: [id, businessId], onDelete: Restrict)

  @@unique([businessId, area, name])
  @@unique([id, businessId])
  @@index([businessId, status, checkedAt])
  @@map("readiness_checks")
}

/// CC-P8-009: privacy requests track customer-data access, export, retention or deletion work.
model PrivacyRequest {
  id                     String               @id @default(uuid()) @db.Uuid
  businessId             String               @db.Uuid
  customerId             String?              @db.Uuid
  requestType            String               @db.VarChar(80)
  requester              String               @db.VarChar(180)
  status                 PrivacyRequestStatus @default(OPEN)
  dueDate                DateTime?            @db.Date
  resolution             String?              @db.VarChar(500)
  createdByMembershipId  String               @db.Uuid
  resolvedByMembershipId String?              @db.Uuid
  createdAt              DateTime             @default(now()) @db.Timestamptz(3)
  resolvedAt             DateTime?            @db.Timestamptz(3)

  business   Business            @relation(fields: [businessId], references: [id], onDelete: Restrict)
  customer   Customer?           @relation(fields: [customerId, businessId], references: [id, businessId], onDelete: Restrict)
  createdBy  BusinessMembership  @relation("PrivacyRequestCreatedBy", fields: [createdByMembershipId, businessId], references: [id, businessId], onDelete: Restrict)
  resolvedBy BusinessMembership? @relation("PrivacyRequestResolvedBy", fields: [resolvedByMembershipId, businessId], references: [id, businessId], onDelete: Restrict)

  @@unique([id, businessId])
  @@index([businessId, status, dueDate])
  @@map("privacy_requests")
}

/// CC-P8-010: release readiness records evidence before a production release.
model ReleaseReadiness {
  id                    String                 @id @default(uuid()) @db.Uuid
  businessId            String                 @db.Uuid
  version               String                 @db.VarChar(80)
  status                ReleaseReadinessStatus @default(DRAFT)
  checklist             Json
  rollbackPlan          String                 @db.VarChar(1000)
  migrationPlan         String?                @db.VarChar(1000)
  createdByMembershipId String                 @db.Uuid
  createdAt             DateTime               @default(now()) @db.Timestamptz(3)
  releasedAt            DateTime?              @db.Timestamptz(3)

  business  Business           @relation(fields: [businessId], references: [id], onDelete: Restrict)
  createdBy BusinessMembership @relation("ReleaseReadinessCreatedBy", fields: [createdByMembershipId, businessId], references: [id, businessId], onDelete: Restrict)

  @@unique([businessId, version])
  @@unique([id, businessId])
  @@index([businessId, status, createdAt])
  @@map("release_readiness")
}
