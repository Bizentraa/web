generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

enum RecordStatus {
  ACTIVE
  INACTIVE
}

enum MembershipStatus {
  INVITED
  ACTIVE
  SUSPENDED
}

enum LocationType {
  SHOP_FLOOR
  WAREHOUSE
  KITCHEN
  VAN
  SERVICE_BAY
  QUARANTINE
  OTHER
}

enum FeatureKind {
  CORE
  BUSINESS_PACK
  OPTIONAL
}

enum ApprovalStrategy {
  ANY_APPROVER
  ALL_APPROVERS
  MINIMUM_APPROVERS
}

enum AuditAction {
  CREATE
  UPDATE
  ACTIVATE
  DEACTIVATE
  APPROVE
  REJECT
  CANCEL
  DELETE
  ASSIGN
  ENABLE
  DISABLE
  GENERATE
}

enum ThemePreset {
  GENERAL_RETAIL
  GROCERY
  FASHION
  ELECTRONICS
  HARDWARE
  BOOKSTORE
  COSMETICS
  FURNITURE
  JEWELRY
  AUTO_PARTS
  RESTAURANT
  CAFE
  BAKERY
  FOOD_TRUCK
  BAR
  HOTEL_REVENUE
  SALON
  GARAGE
  COMPUTER_REPAIR
  LAUNDRY
  TAILORING
  FIELD_SERVICES
  DISTRIBUTION
  VAN_SALES
  RENTAL
  B2B_TRADE
  PHARMACY
  FUEL
  HOTEL
  HEALTHCARE
}

enum ThemeMode {
  LIGHT
  DARK
  SYSTEM
}

enum ItemKind {
  PRODUCT
  SERVICE
  INGREDIENT
  PART
  BUNDLE
  FEE
  RENTAL
}

enum IdentifierKind {
  SKU
  BARCODE
  QR
  SUPPLIER_CODE
  OTHER
}

enum DiscountKind {
  PERCENTAGE
  FIXED_AMOUNT
}

enum TaxRateKind {
  SALES
  PURCHASE
  BOTH
}

enum ImportEntityKind {
  ITEMS
  CUSTOMERS
  SUPPLIERS
  OPENING_DATA
}

enum ImportStatus {
  RECEIVED
  VALIDATED
  FAILED
  APPLIED
  ROLLED_BACK
}

enum ApprovalRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum ShiftStatus {
