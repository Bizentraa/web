enum WebhookSubscriptionStatus {
  ACTIVE
  DISABLED
}

enum WebhookDeliveryStatus {
  PENDING
  SENT
  FAILED
  DEAD_LETTER
}

enum MigrationValidationStatus {
  RECEIVED
  VALIDATED
  FAILED
