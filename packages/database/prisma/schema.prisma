generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

enum RecordStatus {
  ACTIVE
  INACTIVE
}

enum MembershipStatus {
  INVITED
  ACTIVE
  SUSPENDED
}

enum LocationType {
  SHOP_FLOOR
  WAREHOUSE
  KITCHEN
  VAN
  SERVICE_BAY
  QUARANTINE
  OTHER
}

enum FeatureKind {
  CORE
  BUSINESS_PACK
  OPTIONAL
}

enum ApprovalStrategy {
  ANY_APPROVER
  ALL_APPROVERS
  MINIMUM_APPROVERS
}

enum AuditAction {
  CREATE
  UPDATE
  ACTIVATE
  DEACTIVATE
  APPROVE
  REJECT
  CANCEL
  DELETE
  ASSIGN
  ENABLE
  DISABLE
  GENERATE
}

enum ThemePreset {
  GENERAL_RETAIL
  GROCERY
  FASHION
  ELECTRONICS
  HARDWARE
  BOOKSTORE
  COSMETICS
  FURNITURE
  JEWELRY
  AUTO_PARTS
  RESTAURANT
  CAFE
  BAKERY
  FOOD_TRUCK
  BAR
  HOTEL_REVENUE
  SALON
  GARAGE
  COMPUTER_REPAIR
  LAUNDRY
  TAILORING
  FIELD_SERVICES
  DISTRIBUTION
  VAN_SALES
  RENTAL
  B2B_TRADE
  PHARMACY
  FUEL
  HOTEL
  HEALTHCARE
}

enum ThemeMode {
  LIGHT
  DARK
  SYSTEM
}

enum ItemKind {
  PRODUCT
  SERVICE
  INGREDIENT
  PART
  BUNDLE
  FEE
  RENTAL
}

enum IdentifierKind {
  SKU
  BARCODE
  QR
  SUPPLIER_CODE
  OTHER
}

enum DiscountKind {
  PERCENTAGE
  FIXED_AMOUNT
}

enum TaxRateKind {
  SALES
  PURCHASE
  BOTH
}

enum ImportEntityKind {
  ITEMS
  CUSTOMERS
  SUPPLIERS
  OPENING_DATA
}

enum ImportStatus {
  RECEIVED
  VALIDATED
  FAILED
  APPLIED
  ROLLED_BACK
}

enum ApprovalRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum ShiftStatus {
  OPEN
  CLOSED
}

enum CashMovementKind {
  OPENING_FLOAT
  PAY_IN
  PAY_OUT
  SAFE_DROP
  CLOSING_COUNT
}

enum SaleStatus {
  DRAFT
  HELD
  CONFIRMED
  PARTIALLY_RETURNED
  RETURNED
  VOIDED
}

enum SaleChannel {
  POS
  BACK_OFFICE
}

enum PaymentMethodKind {
  CASH
  CARD
  TRANSFER
  QR_WALLET
  STORE_CREDIT
  OTHER
}

enum PaymentDirection {
  IN
  OUT
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  UNKNOWN
  VOIDED
}

enum ReturnStatus {
  DRAFT
  ACCEPTED
  CANCELLED
}

enum RefundMethod {
  ORIGINAL_METHOD
  CASH
  STORE_CREDIT
}

enum StockDisposition {
  RESELLABLE
  DAMAGED
  QUARANTINE
}

enum StoreCreditEntryKind {
  ISSUE
  REDEEM
  ADJUST
}

enum StockMovementKind {
  OPENING
  ADJUSTMENT
  TRANSFER_OUT
  TRANSFER_IN
  RECEIPT
  PICK
  PACK
  DISPATCH
  RETURN
}

enum StockMovementStatus {
  POSTED
  IN_TRANSIT
  CANCELLED
}

enum PurchaseRequestStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
  CONVERTED
  CANCELLED
}

enum PurchaseOrderStatus {
  DRAFT
  APPROVED
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

enum FulfillmentStatus {
  READY_TO_PICK
  PICKING
  PACKED
  DISPATCHED
  CANCELLED
}

model Business {
  id              String       @id @default(uuid()) @db.Uuid
  slug            String       @unique @db.VarChar(80)
  name            String       @db.VarChar(160)
  legalName       String?      @db.VarChar(200)
  email           String?      @db.VarChar(254)
  phone           String?      @db.VarChar(40)
  defaultCurrency String       @db.Char(3)
  timeZone        String       @db.VarChar(80)
  countryCode     String       @db.Char(2)
  status          RecordStatus @default(ACTIVE)
  createdAt       DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime     @updatedAt @db.Timestamptz(3)

  branches          Branch[]
  locations         Location[]
  memberships       BusinessMembership[]
  roles             Role[]
  approvalPolicies  ApprovalPolicy[]
  features          BusinessFeature[]
  auditEvents       AuditEvent[]
  documentSequences DocumentSequence[]
  outboxEvents      OutboxEvent[]
  theme             BusinessTheme?
  units             Unit[]
  itemCategories    ItemCategory[]
  brands            Brand[]
  itemTags          ItemTag[]
  attributes        CustomAttributeDefinition[]
  taxCategories     TaxCategory[]
  priceLists        PriceList[]
  items             Item[]
  promotions        Promotion[]
  customerGroups    CustomerGroup[]
  customers         Customer[]
  suppliers         Supplier[]
  importBatches     ImportBatch[]
  approvalRequests  ApprovalRequest[]
  shifts            PosShift[]
  sales             Sale[]
  saleReturns       SaleReturn[]
  storeCredits      StoreCreditAccount[]
  stockBalances     StockBalance[]
  stockMovements    StockMovement[]
  reorderSettings   ReorderSetting[]
  purchaseRequests  PurchaseRequest[]
  purchaseOrders    PurchaseOrder[]
  goodsReceipts     GoodsReceipt[]
  fulfillmentOrders FulfillmentOrder[]

  @@map("businesses")
}

model Unit {
  id         String       @id @default(uuid()) @db.Uuid
  businessId String       @db.Uuid
  code       String       @db.VarChar(24)
  name       String       @db.VarChar(80)
  precision  Int          @default(0)
  status     RecordStatus @default(ACTIVE)
  createdAt  DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime     @updatedAt @db.Timestamptz(3)

  business        Business         @relation(fields: [businessId], references: [id], onDelete: Restrict)
  baseConversions UnitConversion[] @relation("BaseUnit")
  toConversions   UnitConversion[] @relation("ToUnit")
  items           Item[]
  saleLines       SaleLine[]

  @@unique([businessId, code])
  @@unique([id, businessId])
  @@index([businessId, status])
  @@map("units")
}

model UnitConversion {
  id         String   @id @default(uuid()) @db.Uuid
  businessId String   @db.Uuid
  fromUnitId String   @db.Uuid
  toUnitId   String   @db.Uuid
  factor     Decimal  @db.Decimal(19, 6)
  createdAt  DateTime @default(now()) @db.Timestamptz(3)

  fromUnit Unit @relation("BaseUnit", fields: [fromUnitId, businessId], references: [id, businessId], onDelete: Cascade)
  toUnit   Unit @relation("ToUnit", fields: [toUnitId, businessId], references: [id, businessId], onDelete: Cascade)

  @@unique([businessId, fromUnitId, toUnitId])
  @@map("unit_conversions")
}

model ItemCategory {
  id         String       @id @default(uuid()) @db.Uuid
  businessId String       @db.Uuid
  code       String       @db.VarChar(40)
  name       String       @db.VarChar(120)
  parentId   String?      @db.Uuid
  status     RecordStatus @default(ACTIVE)
  createdAt  DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime     @updatedAt @db.Timestamptz(3)

  business Business @relation(fields: [businessId], references: [id], onDelete: Restrict)
  items    Item[]

  @@unique([businessId, code])
  @@unique([id, businessId])
  @@index([businessId, status])
  @@map("item_categories")
}

model Brand {
  id         String       @id @default(uuid()) @db.Uuid
  businessId String       @db.Uuid
  code       String       @db.VarChar(40)
  name       String       @db.VarChar(120)
  status     RecordStatus @default(ACTIVE)
  createdAt  DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime     @updatedAt @db.Timestamptz(3)

  business Business @relation(fields: [businessId], references: [id], onDelete: Restrict)
  items    Item[]

  @@unique([businessId, code])
  @@unique([id, businessId])
  @@index([businessId, status])
  @@map("brands")
}

model ItemTag {
  id         String       @id @default(uuid()) @db.Uuid
  businessId String       @db.Uuid
  code       String       @db.VarChar(40)
  name       String       @db.VarChar(80)
  status     RecordStatus @default(ACTIVE)
  createdAt  DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime     @updatedAt @db.Timestamptz(3)

  business    Business            @relation(fields: [businessId], references: [id], onDelete: Restrict)
  assignments ItemTagAssignment[]

  @@unique([businessId, code])
  @@unique([id, businessId])
  @@index([businessId, status])
  @@map("item_tags")
}

model ItemTagAssignment {
  id         String   @id @default(uuid()) @db.Uuid
  businessId String   @db.Uuid
  itemId     String   @db.Uuid
  tagId      String   @db.Uuid
  createdAt  DateTime @default(now()) @db.Timestamptz(3)

  item Item    @relation(fields: [itemId, businessId], references: [id, businessId], onDelete: Cascade)
  tag  ItemTag @relation(fields: [tagId, businessId], references: [id, businessId], onDelete: Cascade)

  @@unique([businessId, itemId, tagId])
  @@index([businessId, tagId])
  @@map("item_tag_assignments")
}

model CustomAttributeDefinition {
  id         String       @id @default(uuid()) @db.Uuid
  businessId String       @db.Uuid
  code       String       @db.VarChar(40)
  name       String       @db.VarChar(120)
  appliesTo  String       @db.VarChar(40)
  dataType   String       @db.VarChar(30)
  status     RecordStatus @default(ACTIVE)
  createdAt  DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime     @updatedAt @db.Timestamptz(3)

  business Business             @relation(fields: [businessId], references: [id], onDelete: Restrict)
  values   ItemAttributeValue[]

  @@unique([businessId, code])
  @@unique([id, businessId])
  @@index([businessId, status])
  @@map("custom_attribute_definitions")
}

model TaxCategory {
  id          String       @id @default(uuid()) @db.Uuid
  businessId  String       @db.Uuid
  code        String       @db.VarChar(40)
  name        String       @db.VarChar(120)
  description String?      @db.VarChar(240)
  status      RecordStatus @default(ACTIVE)
  createdAt   DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime     @updatedAt @db.Timestamptz(3)

  business Business  @relation(fields: [businessId], references: [id], onDelete: Restrict)
  rates    TaxRate[]
  items    Item[]

  @@unique([businessId, code])
  @@unique([id, businessId])
  @@index([businessId, status])
  @@map("tax_categories")
}

model TaxRate {
  id            String       @id @default(uuid()) @db.Uuid
  businessId    String       @db.Uuid
  taxCategoryId String       @db.Uuid
  code          String       @db.VarChar(40)
  name          String       @db.VarChar(120)
  rate          Decimal      @db.Decimal(9, 6)
  kind          TaxRateKind  @default(BOTH)
  effectiveFrom DateTime     @db.Date
  effectiveTo   DateTime?    @db.Date
  status        RecordStatus @default(ACTIVE)
  createdAt     DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime     @updatedAt @db.Timestamptz(3)

  category  TaxCategory @relation(fields: [taxCategoryId, businessId], references: [id, businessId], onDelete: Cascade)
  saleLines SaleLine[]

  @@unique([businessId, code])
  @@unique([id, businessId])
  @@index([businessId, taxCategoryId, status])
  @@map("tax_rates")
}

model PriceList {
  id           String       @id @default(uuid()) @db.Uuid
  businessId   String       @db.Uuid
  code         String       @db.VarChar(40)
  name         String       @db.VarChar(120)
  currencyCode String       @db.Char(3)
  isDefault    Boolean      @default(false)
  taxInclusive Boolean      @default(false)
  status       RecordStatus @default(ACTIVE)
  createdAt    DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime     @updatedAt @db.Timestamptz(3)

  business       Business        @relation(fields: [businessId], references: [id], onDelete: Restrict)
  prices         ItemPrice[]
  customerGroups CustomerGroup[]

  @@unique([businessId, code])
  @@unique([id, businessId])
  @@index([businessId, status])
  @@map("price_lists")
}

model Item {
  id            String       @id @default(uuid()) @db.Uuid
  businessId    String       @db.Uuid
  code          String       @db.VarChar(50)
  name          String       @db.VarChar(180)
  kind          ItemKind
  description   String?      @db.VarChar(500)
  categoryId    String?      @db.Uuid
  brandId       String?      @db.Uuid
  baseUnitId    String       @db.Uuid
  taxCategoryId String?      @db.Uuid
  sellable      Boolean      @default(true)
  purchasable   Boolean      @default(false)
  stockTracked  Boolean      @default(false)
  status        RecordStatus @default(ACTIVE)
  createdAt     DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime     @updatedAt @db.Timestamptz(3)

  business             Business              @relation(fields: [businessId], references: [id], onDelete: Restrict)
  category             ItemCategory?         @relation(fields: [categoryId, businessId], references: [id, businessId], onDelete: Restrict)
  brand                Brand?                @relation(fields: [brandId, businessId], references: [id, businessId], onDelete: Restrict)
  baseUnit             Unit                  @relation(fields: [baseUnitId, businessId], references: [id, businessId], onDelete: Restrict)
  taxCategory          TaxCategory?          @relation(fields: [taxCategoryId, businessId], references: [id, businessId], onDelete: Restrict)
  variants             ItemVariant[]
  identifiers          ItemIdentifier[]
  prices               ItemPrice[]
  tagAssignments       ItemTagAssignment[]
  attributeValues      ItemAttributeValue[]
  supplierItems        SupplierItem[]
  saleLines            SaleLine[]
  stockBalances        StockBalance[]
  stockMovements       StockMovement[]
  reorderSettings      ReorderSetting[]
  purchaseRequestLines PurchaseRequestLine[]
  purchaseOrderLines   PurchaseOrderLine[]
  goodsReceiptLines    GoodsReceiptLine[]
  fulfillmentLines     FulfillmentLine[]

  @@unique([businessId, code])
  @@unique([id, businessId])
  @@index([businessId, name])
  @@index([businessId, status])
  @@map("items")
}

model ItemVariant {
  id         String       @id @default(uuid()) @db.Uuid
  businessId String       @db.Uuid
  itemId     String       @db.Uuid
  code       String       @db.VarChar(60)
  name       String       @db.VarChar(180)
  attributes Json         @default("{}")
  status     RecordStatus @default(ACTIVE)
  createdAt  DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime     @updatedAt @db.Timestamptz(3)

  item                 Item                  @relation(fields: [itemId, businessId], references: [id, businessId], onDelete: Cascade)
  identifiers          ItemIdentifier[]
  prices               ItemPrice[]
  saleLines            SaleLine[]
  stockBalances        StockBalance[]
  stockMovements       StockMovement[]
  reorderSettings      ReorderSetting[]
  purchaseRequestLines PurchaseRequestLine[]
  purchaseOrderLines   PurchaseOrderLine[]
  goodsReceiptLines    GoodsReceiptLine[]
  fulfillmentLines     FulfillmentLine[]

  @@unique([businessId, itemId, code])
  @@unique([id, businessId])
  @@index([businessId, status])
  @@map("item_variants")
}

model ItemIdentifier {
  id         String         @id @default(uuid()) @db.Uuid
  businessId String         @db.Uuid
  itemId     String         @db.Uuid
  variantId  String?        @db.Uuid
  kind       IdentifierKind
  value      String         @db.VarChar(120)
  createdAt  DateTime       @default(now()) @db.Timestamptz(3)

  item    Item         @relation(fields: [itemId, businessId], references: [id, businessId], onDelete: Cascade)
  variant ItemVariant? @relation(fields: [variantId, businessId], references: [id, businessId], onDelete: Cascade)

  @@unique([businessId, value])
  @@index([businessId, itemId])
  @@map("item_identifiers")
}

model ItemPrice {
  id          String    @id @default(uuid()) @db.Uuid
  businessId  String    @db.Uuid
  priceListId String    @db.Uuid
  itemId      String    @db.Uuid
  variantId   String?   @db.Uuid
  branchId    String?   @db.Uuid
  unitPrice   Decimal   @db.Decimal(19, 4)
  costPrice   Decimal?  @db.Decimal(19, 4)
  minQuantity Decimal   @default(1) @db.Decimal(19, 4)
  validFrom   DateTime  @default(now()) @db.Timestamptz(3)
  validTo     DateTime? @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @db.Timestamptz(3)

  priceList PriceList    @relation(fields: [priceListId, businessId], references: [id, businessId], onDelete: Cascade)
  item      Item         @relation(fields: [itemId, businessId], references: [id, businessId], onDelete: Cascade)
  variant   ItemVariant? @relation(fields: [variantId, businessId], references: [id, businessId], onDelete: Cascade)
  branch    Branch?      @relation(fields: [branchId, businessId], references: [id, businessId], onDelete: Cascade)

  @@index([businessId, itemId, branchId])
  @@index([businessId, priceListId])
  @@map("item_prices")
}

model Promotion {
  id            String       @id @default(uuid()) @db.Uuid
  businessId    String       @db.Uuid
  code          String       @db.VarChar(40)
  name          String       @db.VarChar(120)
  discountKind  DiscountKind
  discountValue Decimal      @db.Decimal(19, 4)
  startsAt      DateTime     @db.Timestamptz(3)
  endsAt        DateTime?    @db.Timestamptz(3)
  conditions    Json?
  status        RecordStatus @default(ACTIVE)
  createdAt     DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime     @updatedAt @db.Timestamptz(3)

  business  Business   @relation(fields: [businessId], references: [id], onDelete: Restrict)
  saleLines SaleLine[]

  @@unique([businessId, code])
  @@unique([id, businessId])
  @@index([businessId, status, startsAt])
  @@map("promotions")
}

model CustomerGroup {
  id          String       @id @default(uuid()) @db.Uuid
  businessId  String       @db.Uuid
  code        String       @db.VarChar(40)
  name        String       @db.VarChar(120)
  priceListId String?      @db.Uuid
  status      RecordStatus @default(ACTIVE)
  createdAt   DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime     @updatedAt @db.Timestamptz(3)

  business  Business   @relation(fields: [businessId], references: [id], onDelete: Restrict)
  priceList PriceList? @relation(fields: [priceListId, businessId], references: [id, businessId], onDelete: Restrict)
  customers Customer[]

  @@unique([businessId, code])
  @@unique([id, businessId])
  @@index([businessId, status])
  @@index([businessId, priceListId])
  @@map("customer_groups")
}

model Customer {
  id             String       @id @default(uuid()) @db.Uuid
  businessId     String       @db.Uuid
  code           String       @db.VarChar(50)
  name           String       @db.VarChar(180)
  email          String?      @db.VarChar(254)
  phone          String?      @db.VarChar(40)
  groupId        String?      @db.Uuid
  billingAddress Json?
  notes          String?      @db.VarChar(500)
  status         RecordStatus @default(ACTIVE)
  createdAt      DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime     @updatedAt @db.Timestamptz(3)

  business    Business            @relation(fields: [businessId], references: [id], onDelete: Restrict)
  group       CustomerGroup?      @relation(fields: [groupId, businessId], references: [id, businessId], onDelete: Restrict)
  sales       Sale[]
  storeCredit StoreCreditAccount?

  @@unique([businessId, code])
  @@unique([id, businessId])
  @@index([businessId, name])
  @@index([businessId, status])
  @@map("customers")
}

model Supplier {
  id           String       @id @default(uuid()) @db.Uuid
  businessId   String       @db.Uuid
  code         String       @db.VarChar(50)
  name         String       @db.VarChar(180)
  email        String?      @db.VarChar(254)
  phone        String?      @db.VarChar(40)
  leadTimeDays Int?
  paymentTerms String?      @db.VarChar(120)
  address      Json?
  notes        String?      @db.VarChar(500)
  status       RecordStatus @default(ACTIVE)
  createdAt    DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime     @updatedAt @db.Timestamptz(3)

  business       Business        @relation(fields: [businessId], references: [id], onDelete: Restrict)
  supplierItems  SupplierItem[]
  purchaseOrders PurchaseOrder[]

  @@unique([businessId, code])
  @@unique([id, businessId])
  @@index([businessId, name])
  @@index([businessId, status])
  @@map("suppliers")
}

model SupplierItem {
  id           String   @id @default(uuid()) @db.Uuid
  businessId   String   @db.Uuid
  supplierId   String   @db.Uuid
  itemId       String   @db.Uuid
  supplierCode String?  @db.VarChar(80)
  costPrice    Decimal? @db.Decimal(19, 4)
  leadTimeDays Int?
  createdAt    DateTime @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @db.Timestamptz(3)

  supplier Supplier @relation(fields: [supplierId, businessId], references: [id, businessId], onDelete: Cascade)
  item     Item     @relation(fields: [itemId, businessId], references: [id, businessId], onDelete: Cascade)

  @@unique([businessId, supplierId, itemId])
  @@index([businessId, itemId])
  @@map("supplier_items")
}

model ItemAttributeValue {
  id          String   @id @default(uuid()) @db.Uuid
  businessId  String   @db.Uuid
  itemId      String   @db.Uuid
  attributeId String   @db.Uuid
  value       Json
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)

  item       Item                      @relation(fields: [itemId, businessId], references: [id, businessId], onDelete: Cascade)
  definition CustomAttributeDefinition @relation(fields: [attributeId, businessId], references: [id, businessId], onDelete: Cascade)

  @@unique([businessId, itemId, attributeId])
  @@map("item_attribute_values")
}

model ImportBatch {
  id           String           @id @default(uuid()) @db.Uuid
  businessId   String           @db.Uuid
  entityKind   ImportEntityKind
  status       ImportStatus     @default(RECEIVED)
  fileName     String           @db.VarChar(240)
  totalRows    Int              @default(0)
  validRows    Int              @default(0)
  invalidRows  Int              @default(0)
  appliedRows  Int              @default(0)
  errors       Json?
  preview      Json?
  createdIds   Json?
  appliedAt    DateTime?        @db.Timestamptz(3)
  rolledBackAt DateTime?        @db.Timestamptz(3)
  createdAt    DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime         @updatedAt @db.Timestamptz(3)

  business Business @relation(fields: [businessId], references: [id], onDelete: Restrict)

  @@index([businessId, entityKind, status])
  @@map("import_batches")
}

model BusinessTheme {
  businessId          String      @id @db.Uuid
  preset              ThemePreset @default(GENERAL_RETAIL)
  defaultMode         ThemeMode   @default(LIGHT)
  allowUserModeChange Boolean     @default(true)
  brandPrimary        String?     @db.Char(7)
  brandAccent         String?     @db.Char(7)
  revision            Int         @default(1)
  createdAt           DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime    @updatedAt @db.Timestamptz(3)

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@map("business_themes")
}

model Branch {
  id         String       @id @default(uuid()) @db.Uuid
  businessId String       @db.Uuid
  code       String       @db.VarChar(32)
  name       String       @db.VarChar(120)
  email      String?      @db.VarChar(254)
  phone      String?      @db.VarChar(40)
  status     RecordStatus @default(ACTIVE)
  createdAt  DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime     @updatedAt @db.Timestamptz(3)

  business          Business           @relation(fields: [businessId], references: [id], onDelete: Restrict)
  locations         Location[]
  userAssignments   BranchAssignment[]
  auditEvents       AuditEvent[]
  documentSequences DocumentSequence[]
  itemPrices        ItemPrice[]
  approvalRequests  ApprovalRequest[]
  shifts            PosShift[]
  sales             Sale[]
  saleReturns       SaleReturn[]
  stockMovements    StockMovement[]
  purchaseRequests  PurchaseRequest[]
  purchaseOrders    PurchaseOrder[]
  goodsReceipts     GoodsReceipt[]
  fulfillmentOrders FulfillmentOrder[]

  @@unique([businessId, code])
  @@unique([id, businessId])
  @@index([businessId, status])
  @@map("branches")
}

model Location {
  id         String       @id @default(uuid()) @db.Uuid
  businessId String       @db.Uuid
  branchId   String       @db.Uuid
  code       String       @db.VarChar(32)
  name       String       @db.VarChar(120)
  type       LocationType
  status     RecordStatus @default(ACTIVE)
  createdAt  DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime     @updatedAt @db.Timestamptz(3)

  business        Business         @relation(fields: [businessId], references: [id], onDelete: Restrict)
  branch          Branch           @relation(fields: [branchId, businessId], references: [id, businessId], onDelete: Restrict)
  stockBalances   StockBalance[]
  stockMovements  StockMovement[]
  reorderSettings ReorderSetting[]
  goodsReceipts   GoodsReceipt[]

  @@unique([businessId, branchId, code])
  @@unique([id, businessId])
  @@index([businessId, branchId, status])
  @@map("locations")
}

model User {
  id              String       @id @default(uuid()) @db.Uuid
  externalSubject String       @unique @db.VarChar(200)
  email           String       @unique @db.VarChar(254)
  displayName     String       @db.VarChar(160)
  status          RecordStatus @default(ACTIVE)
  createdAt       DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime     @updatedAt @db.Timestamptz(3)

  memberships BusinessMembership[]

  @@map("users")
}

model BusinessMembership {
  id         String           @id @default(uuid()) @db.Uuid
  businessId String           @db.Uuid
  userId     String           @db.Uuid
  status     MembershipStatus @default(INVITED)
  joinedAt   DateTime?        @db.Timestamptz(3)
  createdAt  DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime         @updatedAt @db.Timestamptz(3)

  business           Business           @relation(fields: [businessId], references: [id], onDelete: Restrict)
  user               User               @relation(fields: [userId], references: [id], onDelete: Restrict)
  branchAssignments  BranchAssignment[]
  roleAssignments    MembershipRole[]
  auditEvents        AuditEvent[]       @relation("AuditActor")
  approvalRequests   ApprovalRequest[]  @relation("ApprovalRequestedBy")
  approvalDecisions  ApprovalRequest[]  @relation("ApprovalDecidedBy")
  openedShifts       PosShift[]         @relation("ShiftOpenedBy")
  closedShifts       PosShift[]         @relation("ShiftClosedBy")
  cashMovements      CashMovement[]     @relation("CashMovementCreatedBy")
  sales              Sale[]             @relation("SaleCreatedBy")
  salePayments       SalePayment[]      @relation("PaymentCreatedBy")
  saleReturns        SaleReturn[]       @relation("ReturnCreatedBy")
  storeCreditEntries StoreCreditEntry[] @relation("StoreCreditCreatedBy")
  stockMovements     StockMovement[]    @relation("StockMovementCreatedBy")
  purchaseRequests   PurchaseRequest[]  @relation("PurchaseRequestCreatedBy")
  purchaseOrders     PurchaseOrder[]    @relation("PurchaseOrderCreatedBy")
  goodsReceipts      GoodsReceipt[]     @relation("GoodsReceiptCreatedBy")
  fulfillmentOrders  FulfillmentOrder[] @relation("FulfillmentCreatedBy")

  @@unique([businessId, userId])
  @@unique([id, businessId])
  @@index([businessId, status])
  @@map("business_memberships")
}

model BranchAssignment {
  id           String   @id @default(uuid()) @db.Uuid
  businessId   String   @db.Uuid
  membershipId String   @db.Uuid
  branchId     String   @db.Uuid
  createdAt    DateTime @default(now()) @db.Timestamptz(3)

  membership BusinessMembership @relation(fields: [membershipId, businessId], references: [id, businessId], onDelete: Cascade)
  branch     Branch             @relation(fields: [branchId, businessId], references: [id, businessId], onDelete: Cascade)

  @@unique([businessId, membershipId, branchId])
  @@index([businessId, branchId])
  @@map("branch_assignments")
}

model Role {
  id          String       @id @default(uuid()) @db.Uuid
  businessId  String       @db.Uuid
  code        String       @db.VarChar(50)
  name        String       @db.VarChar(100)
  description String?      @db.VarChar(240)
  isSystem    Boolean      @default(false)
  status      RecordStatus @default(ACTIVE)
  createdAt   DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime     @updatedAt @db.Timestamptz(3)

  business        Business         @relation(fields: [businessId], references: [id], onDelete: Restrict)
  permissions     RolePermission[]
  userAssignments MembershipRole[]

  @@unique([businessId, code])
  @@unique([id, businessId])
  @@index([businessId, status])
  @@map("roles")
}

model Permission {
  id          String   @id @default(uuid()) @db.Uuid
  code        String   @unique @db.VarChar(80)
  name        String   @db.VarChar(120)
  description String?  @db.VarChar(240)
  createdAt   DateTime @default(now()) @db.Timestamptz(3)

  roles RolePermission[]

  @@map("permissions")
}

model RolePermission {
  id           String   @id @default(uuid()) @db.Uuid
  businessId   String   @db.Uuid
  roleId       String   @db.Uuid
  permissionId String   @db.Uuid
  createdAt    DateTime @default(now()) @db.Timestamptz(3)

  role       Role       @relation(fields: [roleId, businessId], references: [id, businessId], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([businessId, roleId, permissionId])
  @@index([businessId, roleId])
  @@map("role_permissions")
}

model MembershipRole {
  id           String   @id @default(uuid()) @db.Uuid
  businessId   String   @db.Uuid
  membershipId String   @db.Uuid
  roleId       String   @db.Uuid
  createdAt    DateTime @default(now()) @db.Timestamptz(3)

  membership BusinessMembership @relation(fields: [membershipId, businessId], references: [id, businessId], onDelete: Cascade)
  role       Role               @relation(fields: [roleId, businessId], references: [id, businessId], onDelete: Cascade)

  @@unique([businessId, membershipId, roleId])
  @@index([businessId, membershipId])
  @@map("membership_roles")
}

model ApprovalPolicy {
  id               String           @id @default(uuid()) @db.Uuid
  businessId       String           @db.Uuid
  actionCode       String           @db.VarChar(80)
  name             String           @db.VarChar(120)
  strategy         ApprovalStrategy @default(ANY_APPROVER)
  minimumApprovers Int              @default(1)
  thresholdAmount  Decimal?         @db.Decimal(19, 4)
  currencyCode     String?          @db.Char(3)
  conditions       Json?
  enabled          Boolean          @default(true)
  createdAt        DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime         @updatedAt @db.Timestamptz(3)

  business Business          @relation(fields: [businessId], references: [id], onDelete: Restrict)
  requests ApprovalRequest[]

  @@unique([businessId, actionCode])
  @@unique([id, businessId])
  @@index([businessId, enabled])
  @@map("approval_policies")
}

model FeatureDefinition {
  id          String      @id @default(uuid()) @db.Uuid
  key         String      @unique @db.VarChar(80)
  name        String      @db.VarChar(120)
  description String?     @db.VarChar(240)
  kind        FeatureKind
  createdAt   DateTime    @default(now()) @db.Timestamptz(3)

  businesses BusinessFeature[]

  @@map("feature_definitions")
}

model BusinessFeature {
  id         String   @id @default(uuid()) @db.Uuid
  businessId String   @db.Uuid
  featureId  String   @db.Uuid
  enabled    Boolean  @default(true)
  settings   Json?
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @db.Timestamptz(3)

  business Business          @relation(fields: [businessId], references: [id], onDelete: Restrict)
  feature  FeatureDefinition @relation(fields: [featureId], references: [id], onDelete: Restrict)

  @@unique([businessId, featureId])
  @@index([businessId, enabled])
  @@map("business_features")
}

model AuditEvent {
  id                String      @id @default(uuid()) @db.Uuid
  businessId        String      @db.Uuid
  branchId          String?     @db.Uuid
  actorMembershipId String?     @db.Uuid
  action            AuditAction
  entityType        String      @db.VarChar(80)
  entityId          String      @db.VarChar(80)
  before            Json?
  after             Json?
  metadata          Json?
  occurredAt        DateTime    @default(now()) @db.Timestamptz(3)

  business        Business            @relation(fields: [businessId], references: [id], onDelete: Restrict)
  branch          Branch?             @relation(fields: [branchId], references: [id], onDelete: SetNull)
  actorMembership BusinessMembership? @relation("AuditActor", fields: [actorMembershipId], references: [id], onDelete: SetNull)

  @@index([businessId, occurredAt])
  @@index([businessId, entityType, entityId])
  @@map("audit_events")
}

model DocumentSequence {
  id           String   @id @default(uuid()) @db.Uuid
  businessId   String   @db.Uuid
  branchId     String?  @db.Uuid
  scopeKey     String   @db.VarChar(80)
  documentType String   @db.VarChar(50)
  prefix       String   @db.VarChar(24)
  nextValue    BigInt   @default(1)
  padding      Int      @default(6)
  createdAt    DateTime @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @db.Timestamptz(3)

  business Business @relation(fields: [businessId], references: [id], onDelete: Restrict)
  branch   Branch?  @relation(fields: [branchId], references: [id], onDelete: Restrict)

  @@unique([businessId, scopeKey, documentType])
  @@index([businessId, branchId])
  @@map("document_sequences")
}

model OutboxEvent {
  id            String    @id @default(uuid()) @db.Uuid
  businessId    String    @db.Uuid
  eventType     String    @db.VarChar(120)
  aggregateType String    @db.VarChar(80)
  aggregateId   String    @db.VarChar(80)
  payload       Json
  occurredAt    DateTime  @default(now()) @db.Timestamptz(3)
  publishedAt   DateTime? @db.Timestamptz(3)
  attempts      Int       @default(0)
  lastError     String?

  business Business @relation(fields: [businessId], references: [id], onDelete: Restrict)

  @@index([publishedAt, occurredAt])
  @@index([businessId, aggregateType, aggregateId])
  @@map("outbox_events")
}

/// CC-P0-007: an approval request is the auditable lifecycle record for one sensitive action.
model ApprovalRequest {
  id                      String                @id @default(uuid()) @db.Uuid
  businessId              String                @db.Uuid
  branchId                String?               @db.Uuid
  policyId                String?               @db.Uuid
  actionCode              String                @db.VarChar(80)
  entityType              String                @db.VarChar(80)
  entityId                String?               @db.VarChar(80)
  status                  ApprovalRequestStatus @default(PENDING)
  amount                  Decimal?              @db.Decimal(19, 4)
  currencyCode            String?               @db.Char(3)
  reason                  String                @db.VarChar(500)
  context                 Json?
  requestedByMembershipId String                @db.Uuid
  decidedByMembershipId   String?               @db.Uuid
  decisionNote            String?               @db.VarChar(500)
  requestedAt             DateTime              @default(now()) @db.Timestamptz(3)
  decidedAt               DateTime?             @db.Timestamptz(3)
  createdAt               DateTime              @default(now()) @db.Timestamptz(3)
  updatedAt               DateTime              @updatedAt @db.Timestamptz(3)

  business    Business            @relation(fields: [businessId], references: [id], onDelete: Restrict)
  branch      Branch?             @relation(fields: [branchId, businessId], references: [id, businessId], onDelete: Restrict)
  policy      ApprovalPolicy?     @relation(fields: [policyId, businessId], references: [id, businessId], onDelete: Restrict)
  requestedBy BusinessMembership  @relation("ApprovalRequestedBy", fields: [requestedByMembershipId, businessId], references: [id, businessId], onDelete: Restrict)
  decidedBy   BusinessMembership? @relation("ApprovalDecidedBy", fields: [decidedByMembershipId, businessId], references: [id, businessId], onDelete: Restrict)
  returns     SaleReturn[]

  @@unique([id, businessId])
  @@index([businessId, status, requestedAt])
  @@index([businessId, actionCode, status])
  @@map("approval_requests")
}

/// CC-P2-001: a POS shift owns opening cash, cash movements and closing reconciliation.
model PosShift {
  id                   String      @id @default(uuid()) @db.Uuid
  businessId           String      @db.Uuid
  branchId             String      @db.Uuid
  registerCode         String      @db.VarChar(40)
  number               String      @db.VarChar(60)
  status               ShiftStatus @default(OPEN)
  openingFloat         Decimal     @db.Decimal(19, 4)
  expectedCash         Decimal?    @db.Decimal(19, 4)
  countedCash          Decimal?    @db.Decimal(19, 4)
  cashVariance         Decimal?    @db.Decimal(19, 4)
  varianceReason       String?     @db.VarChar(500)
  openedByMembershipId String      @db.Uuid
  closedByMembershipId String?     @db.Uuid
  openedAt             DateTime    @default(now()) @db.Timestamptz(3)
  closedAt             DateTime?   @db.Timestamptz(3)
  createdAt            DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime    @updatedAt @db.Timestamptz(3)

  business      Business            @relation(fields: [businessId], references: [id], onDelete: Restrict)
  branch        Branch              @relation(fields: [branchId, businessId], references: [id, businessId], onDelete: Restrict)
  openedBy      BusinessMembership  @relation("ShiftOpenedBy", fields: [openedByMembershipId, businessId], references: [id, businessId], onDelete: Restrict)
  closedBy      BusinessMembership? @relation("ShiftClosedBy", fields: [closedByMembershipId, businessId], references: [id, businessId], onDelete: Restrict)
  cashMovements CashMovement[]
  sales         Sale[]
  returns       SaleReturn[]

  @@unique([businessId, number])
  @@unique([id, businessId])
  @@index([businessId, branchId, status])
  @@map("pos_shifts")
}

/// CC-P2-001: every cash change inside a shift stays visible for reconciliation.
model CashMovement {
  id                    String           @id @default(uuid()) @db.Uuid
  businessId            String           @db.Uuid
  shiftId               String           @db.Uuid
  kind                  CashMovementKind
  amount                Decimal          @db.Decimal(19, 4)
  reason                String           @db.VarChar(240)
  createdByMembershipId String           @db.Uuid
  createdAt             DateTime         @default(now()) @db.Timestamptz(3)

  shift     PosShift           @relation(fields: [shiftId, businessId], references: [id, businessId], onDelete: Cascade)
  createdBy BusinessMembership @relation("CashMovementCreatedBy", fields: [createdByMembershipId, businessId], references: [id, businessId], onDelete: Restrict)

  @@index([businessId, shiftId])
  @@map("cash_movements")
}

/// CC-P2-002: one confirmed sale record shared by POS and Back Office.
model Sale {
  id                    String      @id @default(uuid()) @db.Uuid
  businessId            String      @db.Uuid
  branchId              String      @db.Uuid
  shiftId               String?     @db.Uuid
  number                String      @db.VarChar(60)
  receiptNumber         String?     @db.VarChar(60)
  status                SaleStatus  @default(DRAFT)
  channel               SaleChannel @default(POS)
  customerId            String?     @db.Uuid
  currencyCode          String      @db.Char(3)
  subtotal              Decimal     @default(0) @db.Decimal(19, 4)
  discountTotal         Decimal     @default(0) @db.Decimal(19, 4)
  taxTotal              Decimal     @default(0) @db.Decimal(19, 4)
  total                 Decimal     @default(0) @db.Decimal(19, 4)
  paidTotal             Decimal     @default(0) @db.Decimal(19, 4)
  changeTotal           Decimal     @default(0) @db.Decimal(19, 4)
  dueTotal              Decimal     @default(0) @db.Decimal(19, 4)
  refundedTotal         Decimal     @default(0) @db.Decimal(19, 4)
  idempotencyKey        String      @db.VarChar(80)
  offlineRef            String?     @db.VarChar(80)
  holdName              String?     @db.VarChar(120)
  note                  String?     @db.VarChar(500)
  voidReason            String?     @db.VarChar(500)
  createdByMembershipId String      @db.Uuid
  confirmedAt           DateTime?   @db.Timestamptz(3)
  voidedAt              DateTime?   @db.Timestamptz(3)
  createdAt             DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime    @updatedAt @db.Timestamptz(3)

  business  Business           @relation(fields: [businessId], references: [id], onDelete: Restrict)
  branch    Branch             @relation(fields: [branchId, businessId], references: [id, businessId], onDelete: Restrict)
  shift     PosShift?          @relation(fields: [shiftId, businessId], references: [id, businessId], onDelete: Restrict)
  customer  Customer?          @relation(fields: [customerId, businessId], references: [id, businessId], onDelete: Restrict)
  createdBy BusinessMembership @relation("SaleCreatedBy", fields: [createdByMembershipId, businessId], references: [id, businessId], onDelete: Restrict)
  lines     SaleLine[]
  payments  SalePayment[]
  returns   SaleReturn[]
  credits   StoreCreditEntry[]

  @@unique([businessId, number])
  @@unique([businessId, idempotencyKey])
  @@unique([id, businessId])
  @@index([businessId, branchId, status, createdAt])
  @@index([businessId, customerId])
  @@map("sales")
}

/// CC-P2-002: sale lines keep the resolved price, discount and tax used at sale time.
model SaleLine {
  id               String        @id @default(uuid()) @db.Uuid
  businessId       String        @db.Uuid
  saleId           String        @db.Uuid
  lineNo           Int
  itemId           String        @db.Uuid
  variantId        String?       @db.Uuid
  unitId           String        @db.Uuid
  description      String        @db.VarChar(240)
  quantity         Decimal       @db.Decimal(19, 4)
  unitPrice        Decimal       @db.Decimal(19, 4)
  discountKind     DiscountKind?
  discountValue    Decimal       @default(0) @db.Decimal(19, 4)
  discountAmount   Decimal       @default(0) @db.Decimal(19, 4)
  promotionId      String?       @db.Uuid
  taxRateId        String?       @db.Uuid
  taxRatePercent   Decimal       @default(0) @db.Decimal(9, 6)
  taxAmount        Decimal       @default(0) @db.Decimal(19, 4)
  lineSubtotal     Decimal       @default(0) @db.Decimal(19, 4)
  lineTotal        Decimal       @default(0) @db.Decimal(19, 4)
  costPrice        Decimal?      @db.Decimal(19, 4)
  stockTracked     Boolean       @default(false)
  returnedQuantity Decimal       @default(0) @db.Decimal(19, 4)
  createdAt        DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime      @updatedAt @db.Timestamptz(3)

  sale        Sale             @relation(fields: [saleId, businessId], references: [id, businessId], onDelete: Cascade)
  item        Item             @relation(fields: [itemId, businessId], references: [id, businessId], onDelete: Restrict)
  variant     ItemVariant?     @relation(fields: [variantId, businessId], references: [id, businessId], onDelete: Restrict)
  unit        Unit             @relation(fields: [unitId, businessId], references: [id, businessId], onDelete: Restrict)
  promotion   Promotion?       @relation(fields: [promotionId, businessId], references: [id, businessId], onDelete: Restrict)
  taxRate     TaxRate?         @relation(fields: [taxRateId, businessId], references: [id, businessId], onDelete: Restrict)
  returnLines SaleReturnLine[]

  @@unique([businessId, saleId, lineNo])
  @@unique([id, businessId])
  @@index([businessId, itemId])
  @@map("sale_lines")
}

/// CC-P2-005 and CC-P2-007: each tender attempt is idempotent and keeps its own state.
model SalePayment {
  id                    String            @id @default(uuid()) @db.Uuid
  businessId            String            @db.Uuid
  saleId                String            @db.Uuid
  returnId              String?           @db.Uuid
  method                PaymentMethodKind
  direction             PaymentDirection  @default(IN)
  status                PaymentStatus     @default(PENDING)
  amount                Decimal           @db.Decimal(19, 4)
  tenderedAmount        Decimal?          @db.Decimal(19, 4)
  changeAmount          Decimal           @default(0) @db.Decimal(19, 4)
  reference             String?           @db.VarChar(120)
  failureReason         String?           @db.VarChar(240)
  idempotencyKey        String            @db.VarChar(80)
  createdByMembershipId String            @db.Uuid
  capturedAt            DateTime?         @db.Timestamptz(3)
  createdAt             DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime          @updatedAt @db.Timestamptz(3)

  sale       Sale               @relation(fields: [saleId, businessId], references: [id, businessId], onDelete: Cascade)
  saleReturn SaleReturn?        @relation(fields: [returnId, businessId], references: [id, businessId], onDelete: Restrict)
  createdBy  BusinessMembership @relation("PaymentCreatedBy", fields: [createdByMembershipId, businessId], references: [id, businessId], onDelete: Restrict)

  @@unique([businessId, idempotencyKey])
  @@index([businessId, saleId, status])
  @@map("sale_payments")
}

/// CC-P2-009 to CC-P2-011: a return always references the original sale.
model SaleReturn {
  id                    String       @id @default(uuid()) @db.Uuid
  businessId            String       @db.Uuid
  branchId              String       @db.Uuid
  saleId                String       @db.Uuid
  shiftId               String?      @db.Uuid
  exchangeSaleId        String?      @db.Uuid
  approvalRequestId     String?      @db.Uuid
  number                String       @db.VarChar(60)
  status                ReturnStatus @default(DRAFT)
  reason                String       @db.VarChar(500)
  refundMethod          RefundMethod @default(ORIGINAL_METHOD)
  refundTotal           Decimal      @default(0) @db.Decimal(19, 4)
  storeCreditTotal      Decimal      @default(0) @db.Decimal(19, 4)
  taxTotal              Decimal      @default(0) @db.Decimal(19, 4)
  idempotencyKey        String       @db.VarChar(80)
  createdByMembershipId String       @db.Uuid
  acceptedAt            DateTime?    @db.Timestamptz(3)
  createdAt             DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime     @updatedAt @db.Timestamptz(3)

  business  Business           @relation(fields: [businessId], references: [id], onDelete: Restrict)
  branch    Branch             @relation(fields: [branchId, businessId], references: [id, businessId], onDelete: Restrict)
  sale      Sale               @relation(fields: [saleId, businessId], references: [id, businessId], onDelete: Restrict)
  shift     PosShift?          @relation(fields: [shiftId, businessId], references: [id, businessId], onDelete: Restrict)
  approval  ApprovalRequest?   @relation(fields: [approvalRequestId, businessId], references: [id, businessId], onDelete: Restrict)
  createdBy BusinessMembership @relation("ReturnCreatedBy", fields: [createdByMembershipId, businessId], references: [id, businessId], onDelete: Restrict)
  lines     SaleReturnLine[]
  payments  SalePayment[]
  credits   StoreCreditEntry[]

  @@unique([businessId, number])
  @@unique([businessId, idempotencyKey])
  @@unique([id, businessId])
  @@index([businessId, saleId])
  @@map("sale_returns")
}

/// CC-P2-009: return lines record quantity, money and stock disposition.
model SaleReturnLine {
  id           String           @id @default(uuid()) @db.Uuid
  businessId   String           @db.Uuid
  returnId     String           @db.Uuid
  saleLineId   String           @db.Uuid
  quantity     Decimal          @db.Decimal(19, 4)
  refundAmount Decimal          @default(0) @db.Decimal(19, 4)
  taxAmount    Decimal          @default(0) @db.Decimal(19, 4)
  disposition  StockDisposition @default(RESELLABLE)
  createdAt    DateTime         @default(now()) @db.Timestamptz(3)

  saleReturn SaleReturn @relation(fields: [returnId, businessId], references: [id, businessId], onDelete: Cascade)
  saleLine   SaleLine   @relation(fields: [saleLineId, businessId], references: [id, businessId], onDelete: Restrict)

  @@unique([businessId, returnId, saleLineId])
  @@index([businessId, saleLineId])
  @@map("sale_return_lines")
}

/// CC-P2-010 and CC-P4-010: store credit keeps an auditable balance per Customer.
model StoreCreditAccount {
  id           String   @id @default(uuid()) @db.Uuid
  businessId   String   @db.Uuid
  customerId   String   @db.Uuid
  currencyCode String   @db.Char(3)
  balance      Decimal  @default(0) @db.Decimal(19, 4)
  createdAt    DateTime @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @db.Timestamptz(3)

  business Business           @relation(fields: [businessId], references: [id], onDelete: Restrict)
  customer Customer           @relation(fields: [customerId, businessId], references: [id, businessId], onDelete: Restrict)
  entries  StoreCreditEntry[]

  @@unique([customerId, businessId])
  @@unique([id, businessId])
  @@index([businessId])
  @@map("store_credit_accounts")
}

/// CC-P2-010: every store-credit change keeps its reason and resulting balance.
model StoreCreditEntry {
  id                    String               @id @default(uuid()) @db.Uuid
  businessId            String               @db.Uuid
  accountId             String               @db.Uuid
  kind                  StoreCreditEntryKind
  amount                Decimal              @db.Decimal(19, 4)
  balanceAfter          Decimal              @db.Decimal(19, 4)
  reference             String?              @db.VarChar(120)
  saleId                String?              @db.Uuid
  returnId              String?              @db.Uuid
  createdByMembershipId String               @db.Uuid
  createdAt             DateTime             @default(now()) @db.Timestamptz(3)

  account    StoreCreditAccount @relation(fields: [accountId, businessId], references: [id, businessId], onDelete: Cascade)
  sale       Sale?              @relation(fields: [saleId, businessId], references: [id, businessId], onDelete: Restrict)
  saleReturn SaleReturn?        @relation(fields: [returnId, businessId], references: [id, businessId], onDelete: Restrict)
  createdBy  BusinessMembership @relation("StoreCreditCreatedBy", fields: [createdByMembershipId, businessId], references: [id, businessId], onDelete: Restrict)

  @@index([businessId, accountId, createdAt])
  @@map("store_credit_entries")
}

/// CC-P3-003: current stock position by Item, optional Variant and Location.
model StockBalance {
  id                String   @id @default(uuid()) @db.Uuid
  businessId        String   @db.Uuid
  locationId        String   @db.Uuid
  itemId            String   @db.Uuid
  variantId         String?  @db.Uuid
  onHandQuantity    Decimal  @default(0) @db.Decimal(19, 4)
  reservedQuantity  Decimal  @default(0) @db.Decimal(19, 4)
  incomingQuantity  Decimal  @default(0) @db.Decimal(19, 4)
  availableQuantity Decimal  @default(0) @db.Decimal(19, 4)
  updatedAt         DateTime @updatedAt @db.Timestamptz(3)

  business Business     @relation(fields: [businessId], references: [id], onDelete: Restrict)
  location Location     @relation(fields: [locationId, businessId], references: [id, businessId], onDelete: Restrict)
  item     Item         @relation(fields: [itemId, businessId], references: [id, businessId], onDelete: Restrict)
  variant  ItemVariant? @relation(fields: [variantId, businessId], references: [id, businessId], onDelete: Restrict)

  @@unique([businessId, locationId, itemId, variantId])
  @@unique([id, businessId])
  @@index([businessId, itemId])
  @@index([businessId, locationId])
  @@map("stock_balances")
}

/// CC-P3-001 and CC-P3-002: one physical stock movement creates one authoritative row.
model StockMovement {
  id                    String              @id @default(uuid()) @db.Uuid
  businessId            String              @db.Uuid
  branchId              String              @db.Uuid
  locationId            String              @db.Uuid
  itemId                String              @db.Uuid
  variantId             String?             @db.Uuid
  kind                  StockMovementKind
  status                StockMovementStatus @default(POSTED)
  quantity              Decimal             @db.Decimal(19, 4)
  unitCost              Decimal?            @db.Decimal(19, 4)
  reason                String              @db.VarChar(500)
  referenceType         String?             @db.VarChar(80)
  referenceId           String?             @db.VarChar(80)
  relatedMovementId     String?             @db.Uuid
  createdByMembershipId String              @db.Uuid
  occurredAt            DateTime            @default(now()) @db.Timestamptz(3)
  createdAt             DateTime            @default(now()) @db.Timestamptz(3)

  business  Business           @relation(fields: [businessId], references: [id], onDelete: Restrict)
  branch    Branch             @relation(fields: [branchId, businessId], references: [id, businessId], onDelete: Restrict)
  location  Location           @relation(fields: [locationId, businessId], references: [id, businessId], onDelete: Restrict)
  item      Item               @relation(fields: [itemId, businessId], references: [id, businessId], onDelete: Restrict)
  variant   ItemVariant?       @relation(fields: [variantId, businessId], references: [id, businessId], onDelete: Restrict)
  createdBy BusinessMembership @relation("StockMovementCreatedBy", fields: [createdByMembershipId, businessId], references: [id, businessId], onDelete: Restrict)

  @@unique([id, businessId])
  @@index([businessId, itemId, occurredAt])
  @@index([businessId, locationId, occurredAt])
  @@index([businessId, referenceType, referenceId])
  @@map("stock_movements")
}

/// CC-P3-008: replenishment rule used to propose purchase quantities.
model ReorderSetting {
  id              String   @id @default(uuid()) @db.Uuid
  businessId      String   @db.Uuid
  locationId      String   @db.Uuid
  itemId          String   @db.Uuid
  variantId       String?  @db.Uuid
  minimumQuantity Decimal  @db.Decimal(19, 4)
  targetQuantity  Decimal  @db.Decimal(19, 4)
  createdAt       DateTime @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @db.Timestamptz(3)

  business Business     @relation(fields: [businessId], references: [id], onDelete: Restrict)
  location Location     @relation(fields: [locationId, businessId], references: [id, businessId], onDelete: Restrict)
  item     Item         @relation(fields: [itemId, businessId], references: [id, businessId], onDelete: Restrict)
  variant  ItemVariant? @relation(fields: [variantId, businessId], references: [id, businessId], onDelete: Restrict)

  @@unique([businessId, locationId, itemId, variantId])
  @@unique([id, businessId])
  @@index([businessId, itemId])
  @@map("reorder_settings")
}

/// CC-P3-009: purchase request records demand before supplier commitment.
model PurchaseRequest {
  id                    String                @id @default(uuid()) @db.Uuid
  businessId            String                @db.Uuid
  branchId              String                @db.Uuid
  number                String                @db.VarChar(60)
  status                PurchaseRequestStatus @default(SUBMITTED)
  reason                String                @db.VarChar(500)
  createdByMembershipId String                @db.Uuid
  createdAt             DateTime              @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime              @updatedAt @db.Timestamptz(3)
  approvedAt            DateTime?             @db.Timestamptz(3)

  business  Business              @relation(fields: [businessId], references: [id], onDelete: Restrict)
  branch    Branch                @relation(fields: [branchId, businessId], references: [id, businessId], onDelete: Restrict)
  createdBy BusinessMembership    @relation("PurchaseRequestCreatedBy", fields: [createdByMembershipId, businessId], references: [id, businessId], onDelete: Restrict)
  lines     PurchaseRequestLine[]
  orders    PurchaseOrder[]

  @@unique([businessId, number])
  @@unique([id, businessId])
  @@index([businessId, status, createdAt])
  @@map("purchase_requests")
}

model PurchaseRequestLine {
  id                String   @id @default(uuid()) @db.Uuid
  businessId        String   @db.Uuid
  purchaseRequestId String   @db.Uuid
  itemId            String   @db.Uuid
  variantId         String?  @db.Uuid
  quantity          Decimal  @db.Decimal(19, 4)
  expectedCost      Decimal? @db.Decimal(19, 4)
  note              String?  @db.VarChar(240)

  request PurchaseRequest @relation(fields: [purchaseRequestId, businessId], references: [id, businessId], onDelete: Cascade)
  item    Item            @relation(fields: [itemId, businessId], references: [id, businessId], onDelete: Restrict)
  variant ItemVariant?    @relation(fields: [variantId, businessId], references: [id, businessId], onDelete: Restrict)

  @@index([businessId, itemId])
  @@map("purchase_request_lines")
}

/// CC-P3-010 and CC-P3-011: PO quantities remain separate from receiving and billing.
model PurchaseOrder {
  id                    String              @id @default(uuid()) @db.Uuid
  businessId            String              @db.Uuid
  branchId              String              @db.Uuid
  supplierId            String              @db.Uuid
  purchaseRequestId     String?             @db.Uuid
  number                String              @db.VarChar(60)
  status                PurchaseOrderStatus @default(APPROVED)
  expectedDate          DateTime?           @db.Date
  notes                 String?             @db.VarChar(500)
  createdByMembershipId String              @db.Uuid
  createdAt             DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime            @updatedAt @db.Timestamptz(3)
  approvedAt            DateTime?           @db.Timestamptz(3)

  business  Business            @relation(fields: [businessId], references: [id], onDelete: Restrict)
  branch    Branch              @relation(fields: [branchId, businessId], references: [id, businessId], onDelete: Restrict)
  supplier  Supplier            @relation(fields: [supplierId, businessId], references: [id, businessId], onDelete: Restrict)
  request   PurchaseRequest?    @relation(fields: [purchaseRequestId, businessId], references: [id, businessId], onDelete: Restrict)
  createdBy BusinessMembership  @relation("PurchaseOrderCreatedBy", fields: [createdByMembershipId, businessId], references: [id, businessId], onDelete: Restrict)
  lines     PurchaseOrderLine[]
  receipts  GoodsReceipt[]

  @@unique([businessId, number])
  @@unique([id, businessId])
  @@index([businessId, supplierId, status])
  @@map("purchase_orders")
}

model PurchaseOrderLine {
  id               String  @id @default(uuid()) @db.Uuid
  businessId       String  @db.Uuid
  purchaseOrderId  String  @db.Uuid
  itemId           String  @db.Uuid
  variantId        String? @db.Uuid
  orderedQuantity  Decimal @db.Decimal(19, 4)
  receivedQuantity Decimal @default(0) @db.Decimal(19, 4)
  billedQuantity   Decimal @default(0) @db.Decimal(19, 4)
  returnedQuantity Decimal @default(0) @db.Decimal(19, 4)
  unitCost         Decimal @db.Decimal(19, 4)

  order        PurchaseOrder      @relation(fields: [purchaseOrderId, businessId], references: [id, businessId], onDelete: Cascade)
  item         Item               @relation(fields: [itemId, businessId], references: [id, businessId], onDelete: Restrict)
  variant      ItemVariant?       @relation(fields: [variantId, businessId], references: [id, businessId], onDelete: Restrict)
  receiptLines GoodsReceiptLine[]

  @@unique([id, businessId])
  @@index([businessId, itemId])
  @@map("purchase_order_lines")
}

model GoodsReceipt {
  id                    String   @id @default(uuid()) @db.Uuid
  businessId            String   @db.Uuid
  branchId              String   @db.Uuid
  locationId            String   @db.Uuid
  purchaseOrderId       String   @db.Uuid
  number                String   @db.VarChar(60)
  supplierDocument      String?  @db.VarChar(120)
  createdByMembershipId String   @db.Uuid
  receivedAt            DateTime @default(now()) @db.Timestamptz(3)
  createdAt             DateTime @default(now()) @db.Timestamptz(3)

  business  Business           @relation(fields: [businessId], references: [id], onDelete: Restrict)
  branch    Branch             @relation(fields: [branchId, businessId], references: [id, businessId], onDelete: Restrict)
  location  Location           @relation(fields: [locationId, businessId], references: [id, businessId], onDelete: Restrict)
  order     PurchaseOrder      @relation(fields: [purchaseOrderId, businessId], references: [id, businessId], onDelete: Restrict)
  createdBy BusinessMembership @relation("GoodsReceiptCreatedBy", fields: [createdByMembershipId, businessId], references: [id, businessId], onDelete: Restrict)
  lines     GoodsReceiptLine[]

  @@unique([businessId, number])
  @@unique([id, businessId])
  @@index([businessId, purchaseOrderId])
  @@map("goods_receipts")
}

model GoodsReceiptLine {
  id                  String  @id @default(uuid()) @db.Uuid
  businessId          String  @db.Uuid
  goodsReceiptId      String  @db.Uuid
  purchaseOrderLineId String  @db.Uuid
  itemId              String  @db.Uuid
  variantId           String? @db.Uuid
  receivedQuantity    Decimal @db.Decimal(19, 4)
  unitCost            Decimal @db.Decimal(19, 4)

  receipt   GoodsReceipt      @relation(fields: [goodsReceiptId, businessId], references: [id, businessId], onDelete: Cascade)
  orderLine PurchaseOrderLine @relation(fields: [purchaseOrderLineId, businessId], references: [id, businessId], onDelete: Restrict)
  item      Item              @relation(fields: [itemId, businessId], references: [id, businessId], onDelete: Restrict)
  variant   ItemVariant?      @relation(fields: [variantId, businessId], references: [id, businessId], onDelete: Restrict)

  @@index([businessId, itemId])
  @@map("goods_receipt_lines")
}

/// CC-P3-012: fulfillment preparation for orders that need pick, pack and dispatch.
model FulfillmentOrder {
  id                    String            @id @default(uuid()) @db.Uuid
  businessId            String            @db.Uuid
  branchId              String            @db.Uuid
  number                String            @db.VarChar(60)
  status                FulfillmentStatus @default(READY_TO_PICK)
  customerName          String?           @db.VarChar(180)
  sourceType            String            @db.VarChar(80)
  sourceId              String            @db.VarChar(80)
  createdByMembershipId String            @db.Uuid
  createdAt             DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime          @updatedAt @db.Timestamptz(3)
  dispatchedAt          DateTime?         @db.Timestamptz(3)

  business  Business           @relation(fields: [businessId], references: [id], onDelete: Restrict)
  branch    Branch             @relation(fields: [branchId, businessId], references: [id, businessId], onDelete: Restrict)
  createdBy BusinessMembership @relation("FulfillmentCreatedBy", fields: [createdByMembershipId, businessId], references: [id, businessId], onDelete: Restrict)
  lines     FulfillmentLine[]

  @@unique([businessId, number])
  @@unique([id, businessId])
  @@index([businessId, status, createdAt])
  @@map("fulfillment_orders")
}

model FulfillmentLine {
  id                 String  @id @default(uuid()) @db.Uuid
  businessId         String  @db.Uuid
  fulfillmentOrderId String  @db.Uuid
  itemId             String  @db.Uuid
  variantId          String? @db.Uuid
  quantity           Decimal @db.Decimal(19, 4)
  pickedQuantity     Decimal @default(0) @db.Decimal(19, 4)
  packedQuantity     Decimal @default(0) @db.Decimal(19, 4)

  fulfillment FulfillmentOrder @relation(fields: [fulfillmentOrderId, businessId], references: [id, businessId], onDelete: Cascade)
  item        Item             @relation(fields: [itemId, businessId], references: [id, businessId], onDelete: Restrict)
  variant     ItemVariant?     @relation(fields: [variantId, businessId], references: [id, businessId], onDelete: Restrict)

  @@index([businessId, itemId])
  @@map("fulfillment_lines")
}
