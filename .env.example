# Copy this file to .env for local development. Never commit real secrets.
NODE_ENV=development

# API and frontend
API_PORT=4000
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
BACKOFFICE_PORT=3001
POS_PORT=3000

# Local PostgreSQL and Prisma
POSTGRES_DB=bizentra
POSTGRES_USER=bizentra_admin
POSTGRES_PASSWORD=bizentra_admin_local_only
APP_DB_USER=bizentra_app
APP_DB_PASSWORD=bizentra_app_local_only
DATABASE_URL=postgresql://bizentra_app:bizentra_app_local_only@localhost:5432/bizentra?schema=public
MIGRATION_DATABASE_URL=postgresql://bizentra_admin:bizentra_admin_local_only@localhost:5432/bizentra?schema=public

# Local Redis/BullMQ
REDIS_URL=redis://localhost:6379

# P0 local authentication adapter. Production must use OIDC.
AUTH_MODE=development
